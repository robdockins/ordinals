import ConstructiveOrdinals.NaturalArith
import ConstructiveOrdinals.Veblen.Constructive
import ConstructiveOrdinals.Prelude.Relations

/-!
# Well-founded relations and ordinals

Port of `Ordinal/WellFounded.v`.

Every well-founded relation generates an ordinal (`wfOrd`), and every ordinal
arises this way (`ordR`). *Simulation* and *domination* of relations play the
roles of `≤` and `<` on ordinals. The ordinals generated by the standard
constructions are computed: inverse images, inclusions, transitive closures,
the empty relation, successors, disjoint unions (addition), symmetric
products (smash and natural sums), lexicographic products (multiplication),
lexicographic exponentiation (`ω ^ x`), and list extension (`tree_selection`).

The standard-library relations used here are ported in
`Prelude/Relations.lean`.

Lean's definitional proof irrelevance means that the ordinal generated from
an accessibility proof never depends on which proof is used, so lemmas such
as `wf_ord_Acc_irrelevant` hold by reflexivity.
-/

namespace ConstructiveOrdinals

universe u v w

namespace Ordinal

/-- Rocq: `WellFounded.well_founded_iff_ind`. -/
theorem well_founded_iff_ind (A : Type u) (R : A → A → Prop) :
    WellFounded R ↔ ∀ P : A → Prop, (∀ x, (∀ y, R y x → P y) → P x) → ∀ x, P x :=
  ⟨fun h _ ih x => h.induction x ih, fun h => ⟨h (Acc R) fun x ih => Acc.intro x ih⟩⟩

/-! ## Simulations

If `Simulates R S`, every decrease along `R` can be mimicked by a decrease
along `S`. Simulation is reflexive and transitive, and well-foundedness of
`S` implies that of `R`. Between well-founded relations it plays the role of
`≤` between ordinals; domination plays the role of `<`.
-/

section simulates

variable {A : Type u} {B : Type v} (R : A → A → Prop) (S : B → B → Prop)

/-- Rocq: `WellFounded.simulation`. -/
def Simulation (F : A → B → Prop) : Prop :=
  ∀ (a a' : A) (b : B), R a' a → F a b → ∃ b', S b' b ∧ F a' b'

/-- Rocq: `WellFounded.total`. -/
def Total (F : A → B → Prop) : Prop := ∀ a, ∃ b, F a b

/-- Rocq: `WellFounded.has_dominator`. -/
def HasDominator (F : A → B → Prop) : Prop := ∃ b, ∀ a, ∃ b', S b' b ∧ F a b'

/-- Rocq: `WellFounded.simulates`. -/
def Simulates : Prop := ∃ F, Simulation R S F ∧ Total F

/-- Rocq: `WellFounded.dominates`. -/
def Dominates : Prop := ∃ F, Simulation R S F ∧ HasDominator S F

variable {R S}

/-- Rocq: `WellFounded.simulation_Acc`. -/
theorem simulation_Acc {F : A → B → Prop} (hF : Simulation R S F) (b : B) (hb : Acc S b) :
    ∀ a, F a b → Acc R a := by
  induction hb with
  | intro b _ ih =>
    intro a hab
    exact Acc.intro a fun a' ha' =>
      let ⟨b', hb', hf⟩ := hF a a' b ha' hab
      ih b' hb' a' hf

/-- Rocq: `WellFounded.simulates_wf`. -/
theorem simulates_wf (h : Simulates R S) (hwf : WellFounded S) : WellFounded R :=
  let ⟨_, hF₁, hF₂⟩ := h
  ⟨fun a => let ⟨b, hb⟩ := hF₂ a; simulation_Acc hF₁ b (hwf.apply b) a hb⟩

/-- Rocq: `WellFounded.dominates_simulates`. -/
theorem dominates_simulates (h : Dominates R S) : Simulates R S :=
  let ⟨F, hF₁, _, hF₂⟩ := h
  ⟨F, hF₁, fun a => let ⟨b', _, hb'⟩ := hF₂ a; ⟨b', hb'⟩⟩

end simulates

/-- Rocq: `WellFounded.transitive_simulation`. -/
def transitiveSimulation {A : Type u} {B : Type v} {C : Type w} (F : A → B → Prop)
    (G : B → C → Prop) : A → C → Prop :=
  fun a c => ∃ b, F a b ∧ G b c

/-- Rocq: `WellFounded.transitive_is_simulation`. -/
theorem transitive_is_simulation {A : Type u} {B : Type v} {C : Type w} {F : A → B → Prop}
    {G : B → C → Prop} {R : A → A → Prop} {S : B → B → Prop} {T : C → C → Prop}
    (hF : Simulation R S F) (hG : Simulation S T G) : Simulation R T (transitiveSimulation F G) :=
  fun a a' c hR ⟨b, hFab, hGbc⟩ =>
    let ⟨b', hS, hF'⟩ := hF a a' b hR hFab
    let ⟨c', hT, hG'⟩ := hG b b' c hS hGbc
    ⟨c', hT, b', hF', hG'⟩

/-- Rocq: `WellFounded.simulates_refl`. -/
theorem simulates_refl {A : Type u} (R : A → A → Prop) : Simulates R R :=
  ⟨Eq, fun _ a' _ h e => e ▸ ⟨a', h, rfl⟩, fun a => ⟨a, rfl⟩⟩

/-- Rocq: `WellFounded.simulates_transitive`. -/
theorem simulates_transitive {A : Type u} {B : Type v} {C : Type w} {R : A → A → Prop}
    {S : B → B → Prop} {T : C → C → Prop} (h₁ : Simulates R S) (h₂ : Simulates S T) :
    Simulates R T :=
  let ⟨F, hF₁, hF₂⟩ := h₁
  let ⟨G, hG₁, hG₂⟩ := h₂
  ⟨transitiveSimulation F G, transitive_is_simulation hF₁ hG₁, fun a =>
    let ⟨b, hb⟩ := hF₂ a
    let ⟨c, hc⟩ := hG₂ b
    ⟨c, b, hb, hc⟩⟩

/-- Rocq: `WellFounded.sim_dom_dom`. -/
theorem sim_dom_dom {A : Type u} {B : Type v} {C : Type w} {R : A → A → Prop}
    {S : B → B → Prop} {T : C → C → Prop} (h₁ : Simulates R S) (h₂ : Dominates S T) :
    Dominates R T :=
  let ⟨F, hF₁, hF₂⟩ := h₁
  let ⟨G, hG₁, c, hc⟩ := h₂
  ⟨transitiveSimulation F G, transitive_is_simulation hF₁ hG₁, c, fun a =>
    let ⟨b, hb⟩ := hF₂ a
    let ⟨c', hc₁, hc₂⟩ := hc b
    ⟨c', hc₁, b, hb, hc₂⟩⟩

/-- Rocq: `WellFounded.dom_sim_dom`. -/
theorem dom_sim_dom {A : Type u} {B : Type v} {C : Type w} {R : A → A → Prop}
    {S : B → B → Prop} {T : C → C → Prop} (h₁ : Dominates R S) (h₂ : Simulates S T) :
    Dominates R T :=
  let ⟨F, hF₁, b, hb⟩ := h₁
  let ⟨G, hG₁, hG₂⟩ := h₂
  let ⟨c, hc⟩ := hG₂ b
  ⟨transitiveSimulation F G, transitive_is_simulation hF₁ hG₁, c, fun a =>
    let ⟨b', hb₁, hb₂⟩ := hb a
    let ⟨c', hc₁, hc₂⟩ := hG₁ b b' c hb₁ hc
    ⟨c', hc₁, b', hb₂, hc₂⟩⟩

/-- Rocq: `WellFounded.dominates_transitive`. -/
theorem dominates_transitive {A : Type u} {B : Type v} {C : Type w} {R : A → A → Prop}
    {S : B → B → Prop} {T : C → C → Prop} (h₁ : Dominates R S) (h₂ : Dominates S T) :
    Dominates R T :=
  dom_sim_dom h₁ (dominates_simulates h₂)

/-- Rocq: `WellFounded.dominates_wf_irreflexive`. -/
theorem dominates_wf_irreflexive {A : Type u} (R : A → A → Prop) (hwf : WellFounded R)
    (h : Dominates R R) : False := by
  obtain ⟨F, hF₁, a, H⟩ := h
  obtain ⟨a', ha₁, ha₂⟩ := H a
  clear H
  induction a using hwf.induction generalizing a' with
  | h a ih =>
    obtain ⟨x, hx₁, hx₂⟩ := hF₁ a a' a' ha₁ ha₂
    exact ih a' ha₁ x hx₁ hx₂

/-- Rocq: `WellFounded.rel_compose`. -/
def relCompose {A : Type u} {B : Type v} {C : Type w} (R : A → B → Prop) (S : B → C → Prop) :
    A → C → Prop :=
  fun a c => ∃ b, R a b ∧ S b c

section wf_self_simulation

variable {A : Type u} {R F : A → A → Prop}

/-- Rocq: `WellFounded.self_simulation_prefix`. -/
theorem self_simulation_prefix (_hrefl : ∀ x, F x x) (hsym : ∀ x y, F x y → F y x)
    (htrans : ∀ x y z, F x y → F y z → F x z) (hsim : Simulation R R F) :
    Simulates (relCompose F R) R :=
  ⟨fun b a => F a b, fun a _ c ⟨d, h₁, h₂⟩ h₃ =>
    let ⟨q, h₄, h₅⟩ := hsim a d c h₂ (hsym _ _ h₃)
    ⟨q, h₄, hsym _ _ (htrans _ _ _ h₁ h₅)⟩,
   fun a => ⟨a, _hrefl a⟩⟩

/-- Rocq: `WellFounded.self_simulation_suffix`. -/
theorem self_simulation_suffix (hrefl : ∀ x, F x x) (htrans : ∀ x y z, F x y → F y z → F x z)
    (hsim : Simulation R R F) : Simulates (relCompose R F) R :=
  ⟨F, fun _ b c ⟨d, h₁, h₂⟩ h₃ =>
    let ⟨q, h₄, h₅⟩ := hsim d b c h₁ (htrans _ _ _ h₂ h₃)
    ⟨q, h₄, h₅⟩,
   fun a => ⟨a, hrefl a⟩⟩

/-- Rocq: `WellFounded.self_simulation_prefix'`. -/
theorem self_simulation_prefix' (hrefl : ∀ x, F x x) : Simulates R (relCompose R F) :=
  ⟨Eq, fun _ a' _ h e => e ▸ ⟨a', ⟨_, h, hrefl _⟩, rfl⟩, fun a => ⟨a, rfl⟩⟩

/-- Rocq: `WellFounded.self_simulation_suffix'`. -/
theorem self_simulation_suffix' (hrefl : ∀ x, F x x) : Simulates R (relCompose F R) :=
  ⟨Eq, fun _ a' _ h e => e ▸ ⟨a', ⟨a', hrefl a', h⟩, rfl⟩, fun a => ⟨a, rfl⟩⟩

/-- Rocq: `WellFounded.wf_self_simulation_prefix`. -/
theorem wf_self_simulation_prefix (hrefl : ∀ x, F x x) (hsym : ∀ x y, F x y → F y x)
    (htrans : ∀ x y z, F x y → F y z → F x z) (hsim : Simulation R R F) (hwf : WellFounded R) :
    WellFounded (relCompose F R) :=
  simulates_wf (self_simulation_prefix hrefl hsym htrans hsim) hwf

/-- Rocq: `WellFounded.wf_self_simulation_suffix`. -/
theorem wf_self_simulation_suffix (hrefl : ∀ x, F x x) (htrans : ∀ x y z, F x y → F y z → F x z)
    (hsim : Simulation R R F) (hwf : WellFounded R) : WellFounded (relCompose R F) :=
  simulates_wf (self_simulation_suffix hrefl htrans hsim) hwf

end wf_self_simulation

/-! ## Well-founded relations generate ordinals -/

section wf_ord

variable {A : Type u} (R : A → A → Prop)

/-- The ordinal of an accessible element: the limit of the ordinals of its
predecessors. Rocq: `WellFounded.mk_wf_ord`. -/
def mkWfOrd (a : A) (h : Acc R a) : Ordinal.{u} :=
  Acc.rec (motive := fun _ _ => Ordinal.{u}) (fun a _ ih => mk { a' // R a' a } fun x => ih x.1 x.2) h

theorem mkWfOrd_unfold (a : A) (h : Acc R a) :
    mkWfOrd R a h = mk { a' // R a' a } fun x => mkWfOrd R x.1 (h.inv x.2) := by
  cases h; rfl

variable {R}

/-- Rocq: `WellFounded.wf_ord_Acc_irrelevant`. -/
theorem wf_ord_Acc_irrelevant (a : A) (h₁ h₂ : Acc R a) : mkWfOrd R a h₁ ≤ mkWfOrd R a h₂ :=
  le_refl _

/-- Rocq: `WellFounded.mk_wf_ord_lt`. -/
theorem mk_wf_ord_lt (a : A) (ha : Acc R a) (a' : A) (ha' : Acc R a') (h : R a' a) :
    mkWfOrd R a' ha' < mkWfOrd R a ha := by
  rw [mkWfOrd_unfold R a ha]
  exact lt_intro (show { a' // R a' a } from ⟨a', h⟩) (le_refl _)

theorem acc_of_closTrans {a a' : A} (ha : Acc R a) (h : ClosTrans R a' a) : Acc R a' := by
  induction h with
  | step h => exact ha.inv h
  | trans _ _ ih₁ ih₂ => exact ih₁ (ih₂ ha)

theorem acc_of_closReflTrans {a a' : A} (ha : Acc R a) (h : ClosReflTrans R a' a) : Acc R a' := by
  induction h with
  | step h => exact ha.inv h
  | refl => exact ha
  | trans _ _ ih₁ ih₂ => exact ih₁ (ih₂ ha)

/-- Rocq: `WellFounded.mk_wf_ord_lt_trans`. -/
theorem mk_wf_ord_lt_trans (a : A) (ha : Acc R a) (a' : A) (ha' : Acc R a') (h : ClosTrans R a' a) :
    mkWfOrd R a' ha' < mkWfOrd R a ha := by
  revert ha ha'
  induction h with
  | step h => intro ha ha'; exact mk_wf_ord_lt _ _ _ _ h
  | trans _ h₂ ih₁ ih₂ =>
    intro ha ha'
    exact lt_trans (ih₁ (acc_of_closTrans ha h₂) ha') (ih₂ ha (acc_of_closTrans ha h₂))

/-- Rocq: `WellFounded.mk_wf_ord_le_trans`. -/
theorem mk_wf_ord_le_trans (a : A) (ha : Acc R a) (a' : A) (ha' : Acc R a') (h : ClosReflTrans R a' a) :
    mkWfOrd R a' ha' ≤ mkWfOrd R a ha := by
  revert ha ha'
  induction h with
  | step h => intro ha ha'; exact le_of_lt (mk_wf_ord_lt _ _ _ _ h)
  | refl => intro _ _; exact le_refl _
  | trans _ h₂ ih₁ ih₂ =>
    intro ha ha'
    exact le_trans (ih₁ (acc_of_closReflTrans ha h₂) ha') (ih₂ ha (acc_of_closReflTrans ha h₂))

variable (R)

/-- The ordinal of an element, for a well-founded relation.
Rocq: `WellFounded.wf_ord_elt`. -/
def wfOrdElt (hwf : WellFounded R) (a : A) : Ordinal.{u} := mkWfOrd R a (hwf.apply a)

variable {R}

/-- Rocq: `WellFounded.wf_ord_lt`. -/
theorem wf_ord_lt (hwf : WellFounded R) (a a' : A) (h : R a' a) : wfOrdElt R hwf a' < wfOrdElt R hwf a :=
  mk_wf_ord_lt _ _ _ _ h

/-- Rocq: `WellFounded.wf_ord_lt_trans`. -/
theorem wf_ord_lt_trans (hwf : WellFounded R) (a a' : A) (h : ClosTrans R a' a) :
    wfOrdElt R hwf a' < wfOrdElt R hwf a :=
  mk_wf_ord_lt_trans _ _ _ _ h

/-- Rocq: `WellFounded.wf_ord_le_trans`. -/
theorem wf_ord_le_trans (hwf : WellFounded R) (a a' : A) (h : ClosReflTrans R a' a) :
    wfOrdElt R hwf a' ≤ wfOrdElt R hwf a :=
  mk_wf_ord_le_trans _ _ _ _ h

end wf_ord

/-- The ordinal generated by a well-founded relation. Rocq: `WellFounded.wf_ord`. -/
def wfOrd {A : Type u} (R : A → A → Prop) (h : WellFounded R) : Ordinal.{u} := lim (wfOrdElt R h)

/-- Rocq: `WellFounded.wf_ord_proof_irr_le`. -/
theorem wf_ord_proof_irr_le (A : Type u) (R : A → A → Prop) (h₁ h₂ : WellFounded R) :
    wfOrd R h₁ ≤ wfOrd R h₂ :=
  le_refl _

/-- The ordinal generated by a well-founded relation depends only on the
relation. Rocq: `WellFounded.wf_ord_proof_irr`. -/
theorem wf_ord_proof_irr (A : Type u) (R : A → A → Prop) (h₁ h₂ : WellFounded R) :
    wfOrd R h₁ ≈ wfOrd R h₂ :=
  equiv_refl _

/-- The order type of `<` on `Nat` is `ω`. Rocq: `WellFounded.wf_ord_lt_nat_omega`. -/
theorem wf_ord_lt_nat_omega : wfOrd (fun a b : Nat => a < b) nat_lt_wf ≈ ω := by
  have h₁ : ∀ (i : Nat) (h : Acc (fun a b : Nat => a < b) i), mkWfOrd _ i h ≤ ofNat i := by
    intro i h
    induction h with
    | intro i _ ih =>
      rw [mkWfOrd_unfold]
      exact le_intro fun j => lt_of_le_of_lt (ih j.1 j.2) (ofNat_increasing j.2)
  have h₂ : ∀ (i : Nat) (h : Acc (fun a b : Nat => a < b) i), ofNat i ≤ mkWfOrd _ i h := by
    intro i
    induction i with
    | zero => intro _; exact zero_least _
    | succ i ih =>
      intro h
      rw [mkWfOrd_unfold]
      exact succ_least (lt_intro (show { a' // a' < i + 1 } from ⟨i, Nat.lt_succ_self i⟩) (ih _))
  exact equiv_intro (le_intro fun i => lt_intro (show (ω : Ordinal.{0}).Carrier from ⟨i⟩) (h₁ i _))
    (le_intro fun ⟨i⟩ => lt_intro (show (wfOrd (fun a b : Nat => a < b) nat_lt_wf).Carrier from i) (h₂ i _))

/-! ## Every ordinal is generated by a well-founded relation

The *transitive closure* of an ordinal has the same strength (up to `≈`),
but its carrier contains every intermediate state reachable by following
paths from the root. This gives a "small" type standing for the set of
ordinals below `x`; the subtype `{a // a < x}` would be "large" and cause
universe inconsistencies. Every ordinal therefore generates a well-founded
relation on a small type (`ordR`), and the round trip through `wfOrd`
recovers the ordinal.
-/

/-- Rocq: `WellFounded.ord_transitive_closure_type`. -/
def ordTransitiveClosureType : Ordinal.{u} → Type u
  | mk A f => A ⊕ Σ i : A, ordTransitiveClosureType (f i)

/-- Rocq: `WellFounded.ord_transitive_closure_ord`. -/
def ordTransitiveClosureOrd : (x : Ordinal.{u}) → ordTransitiveClosureType x → Ordinal.{u}
  | mk _ f, .inl i => f i
  | mk _ f, .inr ⟨i, q⟩ => ordTransitiveClosureOrd (f i) q

/-- Rocq: `WellFounded.ord_transitive_closure`. -/
def ordTransitiveClosure (x : Ordinal.{u}) : Ordinal.{u} :=
  mk (ordTransitiveClosureType x) (ordTransitiveClosureOrd x)

/-- Rocq: `WellFounded.ord_transitive_closure_inj`. -/
def ordTransitiveClosureInj : (x : Ordinal.{u}) → x.Carrier → (ordTransitiveClosure x).Carrier
  | mk _ _, i => .inl i

/-- Rocq: `WellFounded.ord_transitive_closure_inj_correct`. -/
theorem ord_transitive_closure_inj_correct : ∀ (x : Ordinal.{u}) (i : x),
    ordTransitiveClosure x (ordTransitiveClosureInj x i) ≈ x i
  | mk _ _, _ => equiv_refl _

/-- Rocq: `WellFounded.transitive_closure_collapse`. -/
def transitiveClosureCollapse : (x : Ordinal.{u}) → (i : ordTransitiveClosureType x) →
    (ordTransitiveClosureOrd x i).Carrier → ordTransitiveClosureType x
  | mk _ f, .inl i, j => .inr ⟨i, ordTransitiveClosureInj (f i) j⟩
  | mk _ f, .inr ⟨i, q⟩, j => .inr ⟨i, transitiveClosureCollapse (f i) q j⟩

/-- Rocq: `WellFounded.transitive_closure_collapse_correct`. -/
theorem transitive_closure_collapse_correct : ∀ (x : Ordinal.{u}) (i : ordTransitiveClosureType x)
    (j : (ordTransitiveClosureOrd x i).Carrier),
    ordTransitiveClosureOrd x (transitiveClosureCollapse x i j) ≈ ordTransitiveClosureOrd x i j
  | mk _ f, .inl i, j => ord_transitive_closure_inj_correct (f i) j
  | mk _ f, .inr ⟨i, q⟩, j => transitive_closure_collapse_correct (f i) q j

/-- Rocq: `WellFounded.ord_transitive_closure_transitive`. -/
theorem ord_transitive_closure_transitive (x : Ordinal.{u}) (i : ordTransitiveClosure x)
    (j : (ordTransitiveClosure x i).Carrier) :
    ∃ k : ordTransitiveClosure x, ordTransitiveClosure x k ≈ ordTransitiveClosure x i j :=
  ⟨transitiveClosureCollapse x i j, transitive_closure_collapse_correct x i j⟩

/-- Rocq: `WellFounded.ord_transitive_closure_le1`. -/
theorem ord_transitive_closure_le1 : ∀ x : Ordinal.{u}, x ≤ ordTransitiveClosure x
  | mk A f => le_intro fun i =>
    lt_intro (show (ordTransitiveClosure (mk A f)).Carrier from .inl i) (le_refl _)

/-- Rocq: `WellFounded.ord_transitive_closure_le2`. -/
theorem ord_transitive_closure_le2 : ∀ x : Ordinal.{u}, ordTransitiveClosure x ≤ x
  | mk A f => le_intro fun
    | .inl i => index_lt (mk A f) i
    | .inr ⟨i, q⟩ => lt_trans (lt_of_lt_of_le (index_lt (ordTransitiveClosure (f i)) q)
        (ord_transitive_closure_le2 (f i))) (index_lt (mk A f) i)

/-- Rocq: `WellFounded.ord_transitive_closure_eq`. -/
theorem ord_transitive_closure_eq (x : Ordinal.{u}) : ordTransitiveClosure x ≈ x :=
  equiv_intro (ord_transitive_closure_le2 x) (ord_transitive_closure_le1 x)

/-- Rocq: `WellFounded.ord_transitive_closure_lt`. -/
theorem ord_transitive_closure_lt (x j : Ordinal.{u}) (h : j < x) :
    ∃ k : ordTransitiveClosure x, j ≤ ordTransitiveClosure x k :=
  lt_elim (lt_of_lt_of_le h (ord_transitive_closure_le1 x))

/-- The well-founded relation generated by an ordinal. Rocq: `WellFounded.ord_R`. -/
def ordR (x : Ordinal.{u}) (a b : ordTransitiveClosureType x) : Prop :=
  ordTransitiveClosureOrd x a < ordTransitiveClosureOrd x b

/-- Rocq: `WellFounded.ord_R_well_founded`. -/
theorem ord_R_well_founded (x : Ordinal.{u}) : WellFounded (ordR x) :=
  wf_inverse_image (· < ·) (ordTransitiveClosureOrd x) lt_wf

/-- Rocq: `WellFounded.ord_R_le1`. -/
theorem ord_R_le1 (x : Ordinal.{u}) : x ≤ wfOrd (ordR x) (ord_R_well_founded x) := by
  refine le_trans (ord_transitive_closure_le1 x) (le_intro fun a => lt_intro (show
    (wfOrd (ordR x) (ord_R_well_founded x)).Carrier from a) ?_)
  show ordTransitiveClosureOrd x a ≤ wfOrdElt (ordR x) (ord_R_well_founded x) a
  induction a using (ord_R_well_founded x).induction with
  | h a ih =>
    refine le_intro fun q => ?_
    obtain ⟨k, hk⟩ := ord_transitive_closure_transitive x a q
    have hka : ordR x k a := lt_of_le_of_lt hk.le (index_lt _ q)
    exact lt_of_le_of_lt hk.ge (lt_of_le_of_lt (ih k hka) (wf_ord_lt _ a k hka))

/-- Rocq: `WellFounded.ord_R_le2`. -/
theorem ord_R_le2 (x : Ordinal.{u}) : wfOrd (ordR x) (ord_R_well_founded x) ≤ x := by
  refine le_trans (le_intro fun a => lt_intro (show (ordTransitiveClosure x).Carrier from a) ?_)
    (ord_transitive_closure_le2 x)
  exact key a _
where
  key (a : ordTransitiveClosureType x) (h : Acc (ordR x) a) :
      mkWfOrd (ordR x) a h ≤ ordTransitiveClosureOrd x a := by
    induction h with
    | intro a _ ih =>
      rw [mkWfOrd_unfold]
      exact le_intro fun q => lt_of_le_of_lt (ih q.1 q.2) q.2

/-- Under a simulation of `ordR x` by `ordR y`, related points have
comparable ordinals. -/
private theorem ordR_simulation_le {x y : Ordinal.{u}} {F : _ → _ → Prop}
    (hF : Simulation (ordR x) (ordR y) F) (a : ordTransitiveClosureType x) :
    ∀ b, F a b → ordTransitiveClosureOrd x a ≤ ordTransitiveClosureOrd y b := by
  induction a using (ord_R_well_founded x).induction with
  | h a ih =>
    intro b hb
    refine le_intro fun q => ?_
    obtain ⟨k, hk⟩ := ord_transitive_closure_transitive x a q
    obtain ⟨b', hb'₁, hb'₂⟩ := hF a k b (lt_of_le_of_lt hk.le (index_lt _ q)) hb
    exact lt_of_le_of_lt hk.ge (lt_of_le_of_lt (ih k (lt_of_le_of_lt hk.le (index_lt _ q)) b' hb'₂) hb'₁)

/-- The canonical simulation used for `ordR`. -/
private theorem ordR_simulation (x y : Ordinal.{u}) :
    Simulation (ordR x) (ordR y)
      (fun a b => ordTransitiveClosureOrd x a ≤ ordTransitiveClosureOrd y b) :=
  fun a a' b ha' hab => by
    obtain ⟨q, hq⟩ := lt_elim (lt_of_lt_of_le ha' hab)
    obtain ⟨b', hb'⟩ := ord_transitive_closure_transitive y b q
    exact ⟨b', lt_of_le_of_lt hb'.le (index_lt _ q), le_trans hq hb'.ge⟩

/-- Rocq: `WellFounded.ord_R_simulates1`. -/
theorem ord_R_simulates1 {x y : Ordinal.{u}} (h : x ≤ y) : Simulates (ordR x) (ordR y) :=
  ⟨_, ordR_simulation x y, fun a =>
    lt_elim (le_elim (le_trans (ord_transitive_closure_eq x).le
      (le_trans h (ord_transitive_closure_eq y).ge)) a)⟩

/-- Rocq: `WellFounded.ord_R_simulates2`. -/
theorem ord_R_simulates2 {x y : Ordinal.{u}} (h : Simulates (ordR x) (ordR y)) : x ≤ y := by
  obtain ⟨F, hF₁, hF₂⟩ := h
  refine le_trans (ord_transitive_closure_eq x).ge (le_trans (le_intro fun a => ?_)
    (ord_transitive_closure_eq y).le)
  obtain ⟨b, hb⟩ := hF₂ a
  exact lt_intro (show (ordTransitiveClosure y).Carrier from b) (ordR_simulation_le hF₁ a b hb)

/-- Rocq: `WellFounded.ord_R_dominates1`. -/
theorem ord_R_dominates1 {x y : Ordinal.{u}} (h : x < y) : Dominates (ordR x) (ordR y) := by
  obtain ⟨b, hb⟩ := lt_elim (lt_of_le_of_lt (ord_transitive_closure_eq x).le
    (lt_of_lt_of_le h (ord_transitive_closure_eq y).ge))
  refine ⟨_, ordR_simulation x y, b, fun a => ?_⟩
  obtain ⟨q, hq⟩ := lt_elim (le_elim hb a)
  obtain ⟨b', hb'⟩ := ord_transitive_closure_transitive y b q
  exact ⟨b', lt_of_le_of_lt hb'.le (index_lt _ q), le_trans hq hb'.ge⟩

/-- Rocq: `WellFounded.ord_R_dominates2`. -/
theorem ord_R_dominates2 {x y : Ordinal.{u}} (h : Dominates (ordR x) (ordR y)) : x < y := by
  obtain ⟨F, hF₁, b, hb⟩ := h
  refine lt_of_le_of_lt (ord_transitive_closure_eq x).ge (lt_of_lt_of_le
    (lt_intro (show (ordTransitiveClosure y).Carrier from b) (le_intro fun a => ?_))
    (ord_transitive_closure_eq y).le)
  obtain ⟨b', hb'₁, hb'₂⟩ := hb a
  exact lt_of_le_of_lt (ordR_simulation_le hF₁ a b' hb'₂) hb'₁

/-- Rocq: `WellFounded.ord_R_simulates`. -/
theorem ord_R_simulates (x y : Ordinal.{u}) : x ≤ y ↔ Simulates (ordR x) (ordR y) :=
  ⟨ord_R_simulates1, ord_R_simulates2⟩

/-- Rocq: `WellFounded.ord_R_dominates`. -/
theorem ord_R_dominates (x y : Ordinal.{u}) : x < y ↔ Dominates (ordR x) (ordR y) :=
  ⟨ord_R_dominates1, ord_R_dominates2⟩

/-- Under a simulation, related points have comparable ordinals. -/
private theorem simulation_wfOrdElt_le {A B : Type u} {R : A → A → Prop} {S : B → B → Prop}
    (HR : WellFounded R) (HS : WellFounded S) {F : A → B → Prop} (hF : Simulation R S F)
    (a : A) : ∀ b, F a b → wfOrdElt R HR a ≤ wfOrdElt S HS b := by
  induction a using HR.induction with
  | h a ih =>
    intro b hb
    show mkWfOrd R a _ ≤ wfOrdElt S HS b
    rw [mkWfOrd_unfold]
    exact le_intro fun ⟨a', ha'⟩ =>
      let ⟨b', hb'₁, hb'₂⟩ := hF a a' b ha' hb
      lt_of_le_of_lt (ih a' ha' b' hb'₂) (wf_ord_lt HS b b' hb'₁)

/-- Rocq: `WellFounded.wf_ord_simulates1`. -/
theorem wf_ord_simulates1 (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
    (HS : WellFounded S) (h : Simulates R S) : wfOrd R HR ≤ wfOrd S HS :=
  let ⟨_, hF₁, hF₂⟩ := h
  le_intro fun a =>
    let ⟨b, hb⟩ := hF₂ a
    lt_intro (show (wfOrd S HS).Carrier from b) (simulation_wfOrdElt_le HR HS hF₁ a b hb)

/-- The simulation `∃ Ha Hb, mkWfOrd R a Ha ≤ mkWfOrd S b Hb` used in Rocq. -/
private theorem wfOrd_le_simulation {A B : Type u} (R : A → A → Prop) (S : B → B → Prop) :
    Simulation R S fun a b => ∃ Ha Hb, mkWfOrd R a Ha ≤ mkWfOrd S b Hb :=
  fun a a' b hr ⟨Ha, Hb, hF⟩ => by
    have := mk_wf_ord_lt a Ha a' (Ha.inv hr) hr
    have h' := lt_of_lt_of_le this hF
    rw [mkWfOrd_unfold S b Hb] at h'
    obtain ⟨⟨b', hs⟩, hle⟩ := lt_elim h'
    exact ⟨b', hs, Ha.inv hr, Hb.inv hs, hle⟩

/-- Rocq: `WellFounded.wf_ord_simulates2`. -/
theorem wf_ord_simulates2 (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
    (HS : WellFounded S) (h : wfOrd R HR ≤ wfOrd S HS) : Simulates R S :=
  ⟨_, wfOrd_le_simulation R S, fun a =>
    let ⟨b, hb⟩ := lt_elim (le_elim h a)
    ⟨b, HR.apply a, HS.apply b, hb⟩⟩

/-- Rocq: `WellFounded.wf_ord_dominates1`. -/
theorem wf_ord_dominates1 (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
    (HS : WellFounded S) (h : Dominates R S) : wfOrd R HR < wfOrd S HS :=
  let ⟨_, hF₁, b, hb⟩ := h
  lt_intro (show (wfOrd S HS).Carrier from b) (limit_least fun a =>
    let ⟨b', hb₁, hb₂⟩ := hb a
    lt_of_le_of_lt (simulation_wfOrdElt_le HR HS hF₁ a b' hb₂) (wf_ord_lt HS b b' hb₁))

/-- Rocq: `WellFounded.wf_ord_dominates2`. -/
theorem wf_ord_dominates2 (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
    (HS : WellFounded S) (h : wfOrd R HR < wfOrd S HS) : Dominates R S := by
  obtain ⟨b, hb⟩ := lt_elim h
  refine ⟨_, wfOrd_le_simulation R S, b, fun a => ?_⟩
  have h' := le_elim hb a
  show ∃ b', S b' b ∧ ∃ Ha Hb, mkWfOrd R a Ha ≤ mkWfOrd S b' Hb
  change mkWfOrd R a _ < mkWfOrd S b _ at h'
  rw [mkWfOrd_unfold S b] at h'
  obtain ⟨⟨b', hs⟩, hle⟩ := lt_elim h'
  exact ⟨b', hs, _, _, hle⟩

/-- Rocq: `WellFounded.wf_ord_simulates`. -/
theorem wf_ord_simulates (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
    (HS : WellFounded S) : wfOrd R HR ≤ wfOrd S HS ↔ Simulates R S :=
  ⟨wf_ord_simulates2 A B R S HR HS, wf_ord_simulates1 A B R S HR HS⟩

/-- Rocq: `WellFounded.wf_ord_dominates`. -/
theorem wf_ord_dominates (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
    (HS : WellFounded S) : wfOrd R HR < wfOrd S HS ↔ Dominates R S :=
  ⟨wf_ord_dominates2 A B R S HR HS, wf_ord_dominates1 A B R S HR HS⟩

/-- `≤` on ordinals is simulation of their relations, and conversely.
Rocq: `WellFounded.ordinal_simulations`. -/
theorem ordinal_simulations :
    (∀ x y : Ordinal.{u}, x ≤ y ↔ Simulates (ordR x) (ordR y)) ∧
    (∀ (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
      (HS : WellFounded S), wfOrd R HR ≤ wfOrd S HS ↔ Simulates R S) :=
  ⟨ord_R_simulates, wf_ord_simulates⟩

/-- `<` on ordinals is domination of their relations, and conversely.
Rocq: `WellFounded.ordinal_dominations`. -/
theorem ordinal_dominations :
    (∀ x y : Ordinal.{u}, x < y ↔ Dominates (ordR x) (ordR y)) ∧
    (∀ (A B : Type u) (R : A → A → Prop) (S : B → B → Prop) (HR : WellFounded R)
      (HS : WellFounded S), wfOrd R HR < wfOrd S HS ↔ Dominates R S) :=
  ⟨ord_R_dominates, wf_ord_dominates⟩

/-- Rocq: `WellFounded.ord_R_round_trip`. -/
theorem ord_R_round_trip (x : Ordinal.{u}) : wfOrd (ordR x) (ord_R_well_founded x) ≈ x :=
  equiv_intro (ord_R_le2 x) (ord_R_le1 x)

/-- Rocq: `WellFounded.simulates_round_trip1`. -/
theorem simulates_round_trip1 (A : Type u) (R : A → A → Prop) (HR : WellFounded R) :
    Simulates R (ordR (wfOrd R HR)) :=
  ⟨fun a b => (Sum.inl a : ordTransitiveClosureType (wfOrd R HR)) = b,
   fun a a' _ h e => e ▸ ⟨.inl a', wf_ord_lt HR a a' h, rfl⟩,
   fun a => ⟨.inl a, rfl⟩⟩

/-- Rocq: `WellFounded.simulates_round_trip2`. -/
theorem simulates_round_trip2 (A : Type u) (R : A → A → Prop) (HR : WellFounded R) :
    Simulates (ordR (wfOrd R HR)) R := by
  refine ⟨fun a b => ordTransitiveClosureOrd (wfOrd R HR) a ≤ wfOrdElt R HR b, ?_, fun a => ?_⟩
  · intro a a' b ha hab
    have h := lt_of_lt_of_le ha hab
    change _ < mkWfOrd R b _ at h
    rw [mkWfOrd_unfold] at h
    obtain ⟨⟨b', hb'⟩, hle⟩ := lt_elim h
    exact ⟨b', hb', hle⟩
  · exact lt_elim (lt_of_lt_of_le (index_lt (ordTransitiveClosure (wfOrd R HR)) a)
      (ord_transitive_closure_le2 _))

/-! ## Standard constructions -/

section inverse_image

variable {A B : Type u} (R : B → B → Prop) (f : A → B)

/-- Rocq: `WellFounded.Rof_simulates`. -/
theorem Rof_simulates : Simulates (fun x y => R (f x) (f y)) R :=
  ⟨fun a b => f a = b, fun _ a' _ h e => e ▸ ⟨f a', h, rfl⟩, fun a => ⟨f a, rfl⟩⟩

/-- Rocq: `WellFounded.inverse_image_ord`. -/
theorem inverse_image_ord (HwfR : WellFounded R) :
    wfOrd _ (wf_inverse_image R f HwfR) ≤ wfOrd R HwfR :=
  wf_ord_simulates1 _ _ _ _ _ _ (Rof_simulates R f)

end inverse_image

section inclusion

variable {A : Type u} (R₁ R₂ : A → A → Prop)

/-- Rocq: `WellFounded.inclusion_simulates`. -/
theorem inclusion_simulates (hincl : ∀ x y, R₁ x y → R₂ x y) : Simulates R₁ R₂ :=
  ⟨Eq, fun _ a' _ h e => e ▸ ⟨a', hincl _ _ h, rfl⟩, fun a => ⟨a, rfl⟩⟩

/-- Rocq: `WellFounded.inclusion_ord`. -/
theorem inclusion_ord (hincl : ∀ x y, R₁ x y → R₂ x y) (HwfR₂ : WellFounded R₂) :
    wfOrd R₁ (wf_incl R₁ R₂ hincl HwfR₂) ≤ wfOrd R₂ HwfR₂ :=
  wf_ord_simulates1 _ _ _ _ _ _ (inclusion_simulates R₁ R₂ hincl)

end inclusion

section transitive_closure

variable {A : Type u} (R : A → A → Prop)

/-- Rocq: `WellFounded.t_clos_simulates1`. -/
theorem t_clos_simulates1 : Simulates R (ClosTrans R) :=
  ⟨Eq, fun _ a' _ h e => e ▸ ⟨a', .step h, rfl⟩, fun a => ⟨a, rfl⟩⟩

private theorem closTrans_rt {x y z : A} (h₁ : ClosTrans R x y) (h₂ : ClosReflTrans R y z) :
    ClosTrans R x z := by
  induction h₂ with
  | step h => exact .trans h₁ (.step h)
  | refl => exact h₁
  | trans _ _ ih₁ ih₂ => exact ih₂ (ih₁ h₁)

/-- Rocq: `WellFounded.t_clos_simulates2`. -/
theorem t_clos_simulates2 : Simulates (ClosTrans R) R :=
  ⟨ClosReflTrans R, fun _ a' _ h hab =>
    match clos_trans_tn1 (closTrans_rt R h hab) with
    | .step h' => ⟨a', h', .refl a'⟩
    | .trans h' h'' => ⟨_, h', clos_t_clos_rt (clos_tn1_trans h'')⟩,
   fun a => ⟨a, .refl a⟩⟩

/-- Rocq: `WellFounded.clos_trans_ord_eq`. -/
theorem clos_trans_ord_eq (HwfR : WellFounded R) :
    wfOrd (ClosTrans R) (wf_clos_trans HwfR) ≈ wfOrd R HwfR :=
  equiv_intro (wf_ord_simulates1 _ _ _ _ _ _ (t_clos_simulates2 R))
    (wf_ord_simulates1 _ _ _ _ _ _ (t_clos_simulates1 R))

end transitive_closure

/-- The empty relation. Rocq: `WellFounded.zero_R`. -/
def zeroR (_ _ : PEmpty.{u + 1}) : Prop := False

/-- Rocq: `WellFounded.zero_R_wf`. -/
theorem zero_R_wf : WellFounded zeroR.{u} := ⟨fun a => PEmpty.elim a⟩

/-- Rocq: `WellFounded.zero_relation_is_zero`. -/
theorem zero_relation_is_zero : wfOrd zeroR.{u} zero_R_wf ≈ 0 :=
  equiv_intro (limit_least fun a => PEmpty.elim a) (zero_least _)

section succ_relation

variable {A : Type u} (R : A → A → Prop)

/-- Adds a new top element. Rocq: `WellFounded.succ_R`. -/
inductive SuccR : Option A → Option A → Prop
  /-- Rocq: `succ_R_start`. -/
  | start (a : A) : SuccR (some a) none
  /-- Rocq: `succ_R_step`. -/
  | step {a' a : A} : R a' a → SuccR (some a') (some a)

variable {R}

/-- Rocq: `WellFounded.succ_R_Some_Acc`. -/
theorem succ_R_Some_Acc (HwfR : WellFounded R) (a : A) : Acc (SuccR R) (some a) := by
  induction a using HwfR.induction with
  | h a ih =>
    refine Acc.intro _ fun a' ha' => ?_
    cases ha' with
    | step h => exact ih _ h

/-- Rocq: `WellFounded.well_founded_succ_R`. -/
theorem well_founded_succ_R (HwfR : WellFounded R) : WellFounded (SuccR R) :=
  ⟨fun
    | some a => succ_R_Some_Acc HwfR a
    | none => Acc.intro _ fun a' ha' => by
        cases ha' with
        | start a => exact succ_R_Some_Acc HwfR a⟩

/-- Rocq: `WellFounded.succ_R_some_elt`. -/
theorem succ_R_some_elt (a : A) (ha₁ : Acc (SuccR R) (some a)) (ha₂ : Acc R a) :
    mkWfOrd (SuccR R) (some a) ha₁ ≈ mkWfOrd R a ha₂ := by
  induction ha₂ with
  | intro a _ ih =>
    rw [mkWfOrd_unfold, mkWfOrd_unfold R]
    refine equiv_intro (le_intro fun ⟨a', ha'⟩ => ?_) (le_intro fun ⟨c, hc⟩ => ?_)
    · cases ha' with
      | step h =>
        exact lt_intro (show { a' // R a' a } from ⟨_, h⟩) (ih _ h _).le
    · exact lt_intro (show { a' // SuccR R a' (some a) } from ⟨some c, .step hc⟩) (ih c hc _).ge

/-- Rocq: `WellFounded.succ_R_is_succ`. -/
theorem succ_R_is_succ (HwfR : WellFounded R) :
    wfOrd (SuccR R) (well_founded_succ_R HwfR) ≈ succ (wfOrd R HwfR) := by
  refine equiv_intro (limit_least fun o => ?_) (succ_least ?_)
  · match o with
    | some a =>
      exact succ_trans (le_of_lt (lt_of_le_of_lt (succ_R_some_elt a _ (HwfR.apply a)).le
        (limit_lt (wfOrdElt R HwfR) a)))
    | none =>
      refine succ_trans ?_
      show mkWfOrd (SuccR R) none _ ≤ _
      rw [mkWfOrd_unfold]
      refine le_intro fun ⟨o, ho⟩ => ?_
      cases ho with
      | start a =>
        exact lt_of_le_of_lt (succ_R_some_elt a _ (HwfR.apply a)).le (limit_lt (wfOrdElt R HwfR) a)
  · refine lt_intro (show (wfOrd (SuccR R) (well_founded_succ_R HwfR)).Carrier from none) ?_
    show wfOrd R HwfR ≤ mkWfOrd (SuccR R) none _
    rw [mkWfOrd_unfold]
    exact le_intro fun a => lt_intro (show { a' // SuccR R a' none } from ⟨some a, .start a⟩)
      (succ_R_some_elt a _ _).ge

end succ_relation

/-- Anything below `mkWfOrd R a` is bounded by the ordinal of a predecessor. -/
theorem lt_mkWfOrd {A : Type u} {R : A → A → Prop} {a : A} {ha : Acc R a} {i : Ordinal.{u}}
    (h : i < mkWfOrd R a ha) : ∃ (a' : A) (h' : R a' a), i ≤ mkWfOrd R a' (ha.inv h') := by
  rw [mkWfOrd_unfold] at h
  obtain ⟨⟨a', h'⟩, hle⟩ := lt_elim h
  exact ⟨a', h', hle⟩

section disjoint_union

variable {A B : Type u} {R : A → A → Prop} {S : B → B → Prop}

/-- Rocq: `WellFounded.disj_union_is_add1`. -/
theorem disj_union_is_add1 (_HwfR : WellFounded R) (a : A) (ha : Acc R a)
    (hab : Acc (LeAsB R S) (.inl a)) : mkWfOrd (LeAsB R S) (.inl a) hab ≤ mkWfOrd R a ha := by
  induction ha with
  | intro a _ ih =>
    rw [mkWfOrd_unfold]
    refine le_intro fun ⟨q, hq⟩ => ?_
    cases hq with
    | aa h => exact lt_of_le_of_lt (ih _ h _) (mk_wf_ord_lt _ _ _ _ h)

/-- Rocq: `WellFounded.disj_union_is_add2`. -/
theorem disj_union_is_add2 (HwfR : WellFounded R) (_HwfS : WellFounded S) (b : B) (hb : Acc S b)
    (hab : Acc (LeAsB R S) (.inr b)) :
    mkWfOrd (LeAsB R S) (.inr b) hab ≤ wfOrd R HwfR + mkWfOrd S b hb := by
  induction hb with
  | intro b _ ih =>
    rw [mkWfOrd_unfold (LeAsB R S)]
    refine le_intro fun ⟨q, hq⟩ => ?_
    cases hq with
    | ab x _ =>
      exact lt_of_le_of_lt (disj_union_is_add1 HwfR x (HwfR.apply x) _)
        (lt_of_lt_of_le (limit_lt (wfOrdElt R HwfR) x) (le_add_right _ _))
    | bb h => exact lt_of_le_of_lt (ih _ h _) (add_lt_add_left _ (mk_wf_ord_lt _ _ _ _ h))

/-- Rocq: `WellFounded.disj_union_is_add3`. -/
theorem disj_union_is_add3 (_HwfR : WellFounded R) (a : A) (ha : Acc R a)
    (hab : Acc (LeAsB R S) (.inl a)) : mkWfOrd R a ha ≤ mkWfOrd (LeAsB R S) (.inl a) hab := by
  induction ha with
  | intro a _ ih =>
    rw [mkWfOrd_unfold R]
    exact le_intro fun ⟨a', ha'⟩ =>
      lt_of_le_of_lt (ih a' ha' (hab.inv (.aa ha'))) (mk_wf_ord_lt _ _ _ _ (.aa ha'))

/-- Rocq: `WellFounded.disj_union_is_add4`. -/
theorem disj_union_is_add4 (HwfR : WellFounded R) (_HwfS : WellFounded S) (b : B) (hb : Acc S b)
    (hab : Acc (LeAsB R S) (.inr b)) :
    wfOrd R HwfR + mkWfOrd S b hb ≤ mkWfOrd (LeAsB R S) (.inr b) hab := by
  induction hb with
  | intro b _ ih =>
    rw [mkWfOrd_unfold S, add_unfold]
    refine lub_least (limit_least fun a => ?_) (sup_least fun ⟨b', hb'⟩ => succ_least ?_)
    · exact lt_of_le_of_lt (disj_union_is_add3 HwfR a _ (hab.inv (.ab a b)))
        (mk_wf_ord_lt _ _ _ _ (.ab a b))
    · exact lt_of_le_of_lt (ih b' hb' (hab.inv (.bb hb'))) (mk_wf_ord_lt _ _ _ _ (.bb hb'))

/-- Rocq: `WellFounded.disj_union_add1`. -/
theorem disj_union_add1 (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (LeAsB R S) (wf_disjoint_sum R S HwfR HwfS) ≤ wfOrd R HwfR + wfOrd S HwfS :=
  limit_least fun
    | .inl a => lt_of_le_of_lt (disj_union_is_add1 HwfR a (HwfR.apply a) _)
        (lt_of_lt_of_le (limit_lt (wfOrdElt R HwfR) a) (le_add_right _ _))
    | .inr b => lt_of_le_of_lt (disj_union_is_add2 HwfR HwfS b (HwfS.apply b) _)
        (add_lt_add_left _ (limit_lt (wfOrdElt S HwfS) b))

/-- Rocq: `WellFounded.disj_union_add2`. -/
theorem disj_union_add2 (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd R HwfR + wfOrd S HwfS ≤ wfOrd (LeAsB R S) (wf_disjoint_sum R S HwfR HwfS) := by
  rw [add_unfold]
  exact lub_least
    (limit_least fun a => lt_of_le_of_lt (disj_union_is_add3 HwfR a (HwfR.apply a) _)
      (limit_lt (wfOrdElt (LeAsB R S) (wf_disjoint_sum R S HwfR HwfS)) (.inl a)))
    (sup_least fun b => succ_least (lt_of_le_of_lt (disj_union_is_add4 HwfR HwfS b (HwfS.apply b) _)
      (limit_lt (wfOrdElt (LeAsB R S) (wf_disjoint_sum R S HwfR HwfS)) (.inr b))))

/-- The ordinal of a disjoint union is the sum. Rocq: `WellFounded.disj_union_add`. -/
theorem disj_union_add (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (LeAsB R S) (wf_disjoint_sum R S HwfR HwfS) ≈ wfOrd R HwfR + wfOrd S HwfS :=
  equiv_intro (disj_union_add1 HwfR HwfS) (disj_union_add2 HwfR HwfS)

end disjoint_union

section symprod

variable {A B : Type u} {R : A → A → Prop} {S : B → B → Prop}

/-- Rocq: `WellFounded.symprod_elt_is_nadd1`. -/
theorem symprod_elt_is_nadd1 (_HwfR : WellFounded R) (_HwfS : WellFounded S) (a : A) (b : B)
    (ha : Acc R a) (hb : Acc S b) (hab : Acc (Symprod R S) (a, b)) :
    mkWfOrd (Symprod R S) (a, b) hab ≤ mkWfOrd R a ha ♯ mkWfOrd S b hb := by
  induction ha generalizing b with
  | intro a _ iha =>
    induction hb with
    | intro b _ ihb =>
      rw [mkWfOrd_unfold (Symprod R S)]
      refine le_intro fun ⟨p, hp⟩ => ?_
      cases hp with
      | left h =>
        exact lt_of_le_of_lt (iha _ h _ (Acc.intro _ ‹_›) _) (nadd_increasing1 _ (mk_wf_ord_lt _ _ _ _ h))
      | right h => exact lt_of_le_of_lt (ihb _ h _) (nadd_increasing2 _ (mk_wf_ord_lt _ _ _ _ h))

/-- Rocq: `WellFounded.symprod_elt_is_nadd2`. -/
theorem symprod_elt_is_nadd2 (_HwfR : WellFounded R) (_HwfS : WellFounded S) (a : A) (b : B)
    (ha : Acc R a) (hb : Acc S b) (hab : Acc (Symprod R S) (a, b)) :
    mkWfOrd R a ha ♯ mkWfOrd S b hb ≤ mkWfOrd (Symprod R S) (a, b) hab := by
  induction ha generalizing b with
  | intro a _ iha =>
    induction hb with
    | intro b hb' ihb =>
      refine nadd_least3 (fun i hi => ?_) (fun j hj => ?_)
      · obtain ⟨a', h', hle⟩ := lt_mkWfOrd hi
        exact lt_of_le_of_lt (le_trans (nadd_le_nadd hle (le_refl _))
          (iha a' h' b (Acc.intro _ hb') (hab.inv (.left h' b))))
          (mk_wf_ord_lt _ _ _ _ (.left h' b))
      · obtain ⟨b', h', hle⟩ := lt_mkWfOrd hj
        exact lt_of_le_of_lt (le_trans (nadd_le_nadd (le_refl _) hle)
          (ihb b' h' (hab.inv (.right h' a)))) (mk_wf_ord_lt _ _ _ _ (.right h' a))

/-- Rocq: `WellFounded.symprod_elt_is_nadd`. -/
theorem symprod_elt_is_nadd (HwfR : WellFounded R) (HwfS : WellFounded S) (a : A) (b : B) :
    wfOrdElt (Symprod R S) (wf_symprod R S HwfR HwfS) (a, b) ≈ wfOrdElt R HwfR a ♯ wfOrdElt S HwfS b :=
  equiv_intro (symprod_elt_is_nadd1 HwfR HwfS a b _ _ _) (symprod_elt_is_nadd2 HwfR HwfS a b _ _ _)

/-- The ordinal of a symmetric product is the smash sum.
Rocq: `WellFounded.symprod_is_smash_sum`. -/
theorem symprod_is_smash_sum (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (Symprod R S) (wf_symprod R S HwfR HwfS) ≈ smashSum (wfOrd R HwfR) (wfOrd S HwfS) :=
  equiv_intro
    (limit_least fun ⟨a, b⟩ => lt_intro (show (smashSum (wfOrd R HwfR) (wfOrd S HwfS)).Carrier from (a, b))
      (symprod_elt_is_nadd HwfR HwfS a b).le)
    (limit_least fun ⟨a, b⟩ => lt_intro (show (wfOrd (Symprod R S) (wf_symprod R S HwfR HwfS)).Carrier
      from (a, b)) (symprod_elt_is_nadd HwfR HwfS a b).ge)

/-- Rocq: `WellFounded.symprod_le_nadd`. -/
theorem symprod_le_nadd (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (Symprod R S) (wf_symprod R S HwfR HwfS) ≤ wfOrd R HwfR ♯ wfOrd S HwfS :=
  limit_least fun ⟨a, b⟩ => lt_of_le_of_lt (symprod_elt_is_nadd HwfR HwfS a b).le
    (nadd_lt_mor1 (limit_lt (wfOrdElt R HwfR) a) (le_of_lt (limit_lt (wfOrdElt S HwfS) b)))

end symprod

section symprod'

variable {A B : Type u} (R : A → A → Prop) (S : B → B → Prop)

/-- A variant of the symmetric product whose ordinal is exactly the natural
sum. Rocq: `WellFounded.symprod'`. -/
inductive Symprod' : (A ⊕ B) ⊕ (A × B) → (A ⊕ B) ⊕ (A × B) → Prop
  /-- Rocq: `sym_A`. -/
  | symA {a a' : A} : R a a' → Symprod' (.inl (.inl a)) (.inl (.inl a'))
  /-- Rocq: `sym_B`. -/
  | symB {b b' : B} : S b b' → Symprod' (.inl (.inr b)) (.inl (.inr b'))
  /-- Rocq: `sym_A_to_pair`. -/
  | symAToPair (a : A) (b : B) : Symprod' (.inr (a, b)) (.inl (.inl a))
  /-- Rocq: `sym_B_to_pair`. -/
  | symBToPair (a : A) (b : B) : Symprod' (.inr (a, b)) (.inl (.inr b))
  /-- Rocq: `sym_left`. -/
  | symLeft {a a' : A} (b : B) : R a a' → Symprod' (.inr (a, b)) (.inr (a', b))
  /-- Rocq: `sym_right`. -/
  | symRight (a : A) {b b' : B} : S b b' → Symprod' (.inr (a, b)) (.inr (a, b'))

variable {R S}

/-- Rocq: `WellFounded.Acc_symprod'_pair`. -/
theorem Acc_symprod'_pair (HwfR : WellFounded R) (HwfS : WellFounded S) (a : A) (b : B) :
    Acc (Symprod' R S) (.inr (a, b)) := by
  induction a using HwfR.induction generalizing b with
  | h a iha =>
    induction b using HwfS.induction with
    | h b ihb =>
      refine Acc.intro _ fun y hy => ?_
      cases hy with
      | symLeft _ h => exact iha _ h b
      | symRight _ h => exact ihb _ h

/-- Rocq: `WellFounded.wf_symprod'`. -/
theorem wf_symprod' (HwfR : WellFounded R) (HwfS : WellFounded S) : WellFounded (Symprod' R S) := by
  refine ⟨fun
    | .inl (.inl a) => ?_
    | .inl (.inr b) => ?_
    | .inr (a, b) => Acc_symprod'_pair HwfR HwfS a b⟩
  · induction a using HwfR.induction with
    | h a ih =>
      refine Acc.intro _ fun y hy => ?_
      cases hy with
      | symA h => exact ih _ h
      | symAToPair _ b => exact Acc_symprod'_pair HwfR HwfS _ b
  · induction b using HwfS.induction with
    | h b ih =>
      refine Acc.intro _ fun y hy => ?_
      cases hy with
      | symB h => exact ih _ h
      | symBToPair a _ => exact Acc_symprod'_pair HwfR HwfS a _

/-- Rocq: `WellFounded.symprod'_elt_is_nadd1`. -/
theorem symprod'_elt_is_nadd1 (_HwfR : WellFounded R) (_HwfS : WellFounded S) (a : A) (b : B)
    (ha : Acc R a) (hb : Acc S b) (hab : Acc (Symprod' R S) (.inr (a, b))) :
    mkWfOrd (Symprod' R S) (.inr (a, b)) hab ≤ mkWfOrd R a ha ♯ mkWfOrd S b hb := by
  induction ha generalizing b with
  | intro a _ iha =>
    induction hb with
    | intro b _ ihb =>
      rw [mkWfOrd_unfold (Symprod' R S)]
      refine le_intro fun ⟨p, hp⟩ => ?_
      cases hp with
      | symLeft _ h =>
        exact lt_of_le_of_lt (iha _ h _ (Acc.intro _ ‹_›) _) (nadd_increasing1 _ (mk_wf_ord_lt _ _ _ _ h))
      | symRight _ h => exact lt_of_le_of_lt (ihb _ h _) (nadd_increasing2 _ (mk_wf_ord_lt _ _ _ _ h))

/-- Rocq: `WellFounded.symprod'_elt_is_nadd2`. -/
theorem symprod'_elt_is_nadd2 (_HwfR : WellFounded R) (_HwfS : WellFounded S) (a : A) (b : B)
    (ha : Acc R a) (hb : Acc S b) (hab : Acc (Symprod' R S) (.inr (a, b))) :
    mkWfOrd R a ha ♯ mkWfOrd S b hb ≤ mkWfOrd (Symprod' R S) (.inr (a, b)) hab := by
  induction ha generalizing b with
  | intro a _ iha =>
    induction hb with
    | intro b hb' ihb =>
      refine nadd_least3 (fun i hi => ?_) (fun j hj => ?_)
      · obtain ⟨a', h', hle⟩ := lt_mkWfOrd hi
        exact lt_of_le_of_lt (le_trans (nadd_le_nadd hle (le_refl _))
          (iha a' h' b (Acc.intro _ hb') (hab.inv (.symLeft b h'))))
          (mk_wf_ord_lt _ _ _ _ (.symLeft b h'))
      · obtain ⟨b', h', hle⟩ := lt_mkWfOrd hj
        exact lt_of_le_of_lt (le_trans (nadd_le_nadd (le_refl _) hle)
          (ihb b' h' (hab.inv (.symRight a h')))) (mk_wf_ord_lt _ _ _ _ (.symRight a h'))

/-- Rocq: `WellFounded.symprod'_elt_is_nadd3`. -/
theorem symprod'_elt_is_nadd3 (_HwfR : WellFounded R) (HwfS : WellFounded S) (a : A) (ha : Acc R a)
    (hab : Acc (Symprod' R S) (.inl (.inl a))) :
    mkWfOrd (Symprod' R S) (.inl (.inl a)) hab ≤ mkWfOrd R a ha ♯ wfOrd S HwfS := by
  induction ha with
  | intro a _ ih =>
    rw [mkWfOrd_unfold (Symprod' R S)]
    refine le_intro fun ⟨q, hq⟩ => ?_
    cases hq with
    | symA h => exact lt_of_le_of_lt (ih _ h _) (nadd_increasing1 _ (mk_wf_ord_lt _ _ _ _ h))
    | symAToPair _ b =>
      exact lt_of_le_of_lt (symprod'_elt_is_nadd1 _HwfR HwfS a b (Acc.intro _ ‹_›) (HwfS.apply b) _)
        (nadd_increasing2 _ (limit_lt (wfOrdElt S HwfS) b))

/-- Rocq: `WellFounded.symprod'_elt_is_nadd4`. -/
theorem symprod'_elt_is_nadd4 (_HwfR : WellFounded R) (HwfS : WellFounded S) (a : A) (ha : Acc R a)
    (hab : Acc (Symprod' R S) (.inl (.inl a))) :
    mkWfOrd R a ha ♯ wfOrd S HwfS ≤ mkWfOrd (Symprod' R S) (.inl (.inl a)) hab := by
  induction ha with
  | intro a ha' ih =>
    refine nadd_least3 (fun i hi => ?_) (fun j hj => ?_)
    · obtain ⟨a', h', hle⟩ := lt_mkWfOrd hi
      exact lt_of_le_of_lt (le_trans (nadd_le_nadd hle (le_refl _)) (ih a' h' (hab.inv (.symA h'))))
        (mk_wf_ord_lt _ _ _ _ (.symA h'))
    · obtain ⟨b, hle⟩ := lt_elim hj
      exact lt_of_le_of_lt (le_trans (nadd_le_nadd (le_refl _) hle)
        (symprod'_elt_is_nadd2 _HwfR HwfS a b (Acc.intro _ ha') _ (hab.inv (.symAToPair a b))))
        (mk_wf_ord_lt _ _ _ _ (.symAToPair a b))

/-- Rocq: `WellFounded.symprod'_elt_is_nadd5`. -/
theorem symprod'_elt_is_nadd5 (HwfR : WellFounded R) (_HwfS : WellFounded S) (b : B) (hb : Acc S b)
    (hab : Acc (Symprod' R S) (.inl (.inr b))) :
    mkWfOrd (Symprod' R S) (.inl (.inr b)) hab ≤ wfOrd R HwfR ♯ mkWfOrd S b hb := by
  induction hb with
  | intro b _ ih =>
    rw [mkWfOrd_unfold (Symprod' R S)]
    refine le_intro fun ⟨q, hq⟩ => ?_
    cases hq with
    | symB h => exact lt_of_le_of_lt (ih _ h _) (nadd_increasing2 _ (mk_wf_ord_lt _ _ _ _ h))
    | symBToPair a _ =>
      exact lt_of_le_of_lt (symprod'_elt_is_nadd1 HwfR _HwfS a b (HwfR.apply a) (Acc.intro _ ‹_›) _)
        (nadd_increasing1 _ (limit_lt (wfOrdElt R HwfR) a))

/-- Rocq: `WellFounded.symprod'_elt_is_nadd6`. -/
theorem symprod'_elt_is_nadd6 (HwfR : WellFounded R) (_HwfS : WellFounded S) (b : B) (hb : Acc S b)
    (hab : Acc (Symprod' R S) (.inl (.inr b))) :
    wfOrd R HwfR ♯ mkWfOrd S b hb ≤ mkWfOrd (Symprod' R S) (.inl (.inr b)) hab := by
  induction hb with
  | intro b hb' ih =>
    refine nadd_least3 (fun i hi => ?_) (fun j hj => ?_)
    · obtain ⟨a, hle⟩ := lt_elim hi
      exact lt_of_le_of_lt (le_trans (nadd_le_nadd hle (le_refl _))
        (symprod'_elt_is_nadd2 HwfR _HwfS a b _ (Acc.intro _ hb') (hab.inv (.symBToPair a b))))
        (mk_wf_ord_lt _ _ _ _ (.symBToPair a b))
    · obtain ⟨b', h', hle⟩ := lt_mkWfOrd hj
      exact lt_of_le_of_lt (le_trans (nadd_le_nadd (le_refl _) hle) (ih b' h' (hab.inv (.symB h'))))
        (mk_wf_ord_lt _ _ _ _ (.symB h'))

/-- The ordinal of `symprod'` is exactly the natural sum.
Rocq: `WellFounded.symprod'_is_nadd`. -/
theorem symprod'_is_nadd (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (Symprod' R S) (wf_symprod' HwfR HwfS) ≈ wfOrd R HwfR ♯ wfOrd S HwfS := by
  refine equiv_intro (limit_least fun
    | .inl (.inl a) => ?_
    | .inl (.inr b) => ?_
    | .inr (a, b) => ?_) (nadd_least3 (fun i hi => ?_) (fun j hj => ?_))
  · exact lt_of_le_of_lt (symprod'_elt_is_nadd3 HwfR HwfS a (HwfR.apply a) _)
      (nadd_increasing1 _ (limit_lt (wfOrdElt R HwfR) a))
  · exact lt_of_le_of_lt (symprod'_elt_is_nadd5 HwfR HwfS b (HwfS.apply b) _)
      (nadd_increasing2 _ (limit_lt (wfOrdElt S HwfS) b))
  · exact lt_of_le_of_lt (symprod'_elt_is_nadd1 HwfR HwfS a b (HwfR.apply a) (HwfS.apply b) _)
      (nadd_lt_mor1 (limit_lt (wfOrdElt R HwfR) a) (le_of_lt (limit_lt (wfOrdElt S HwfS) b)))
  · obtain ⟨a, hle⟩ := lt_elim hi
    exact lt_of_le_of_lt (le_trans (nadd_le_nadd hle (le_refl _))
      (symprod'_elt_is_nadd4 HwfR HwfS a _ _))
      (limit_lt (wfOrdElt (Symprod' R S) (wf_symprod' HwfR HwfS)) (.inl (.inl a)))
  · obtain ⟨b, hle⟩ := lt_elim hj
    exact lt_of_le_of_lt (le_trans (nadd_le_nadd (le_refl _) hle)
      (symprod'_elt_is_nadd6 HwfR HwfS b _ _))
      (limit_lt (wfOrdElt (Symprod' R S) (wf_symprod' HwfR HwfS)) (.inl (.inr b)))

/-- Rocq: `WellFounded.symprod_simulates`. -/
theorem symprod_simulates : Simulates (Symprod R S) (Symprod' R S) :=
  ⟨fun a b => .inr a = b, fun _ a' _ h e => by
    subst e
    cases h with
    | left h y => exact ⟨_, .symLeft y h, rfl⟩
    | right h x => exact ⟨_, .symRight x h, rfl⟩,
   fun a => ⟨.inr a, rfl⟩⟩

/-- Rocq: `WellFounded.symprod_ord_le`. -/
theorem symprod_ord_le (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (Symprod R S) (wf_symprod R S HwfR HwfS) ≤ wfOrd (Symprod' R S) (wf_symprod' HwfR HwfS) :=
  wf_ord_simulates1 _ _ _ _ _ _ symprod_simulates

end symprod'

section slexprod

variable {A B : Type u} {R : A → A → Prop} {S : B → B → Prop}

private theorem slexprod_elt_le (HwfS : WellFounded S) (a : A) (ha : Acc R a) :
    ∀ (b : B) (hb : Acc S b) (hab : Acc (Slexprod R S) (a, b)),
      mkWfOrd (Slexprod R S) (a, b) hab ≤ wfOrd S HwfS * mkWfOrd R a ha + mkWfOrd S b hb := by
  induction ha with
  | intro a _ iha =>
    intro b hb
    induction hb with
    | intro b _ ihb =>
      intro hab
      rw [mkWfOrd_unfold (Slexprod R S)]
      refine le_intro fun ⟨p, hp⟩ => ?_
      cases hp with
      | left y _ h =>
        calc mkWfOrd (Slexprod R S) _ _ ≤ wfOrd S HwfS * mkWfOrd R _ _ + mkWfOrd S y (HwfS.apply y) :=
              iha _ h y _ _
          _ < wfOrd S HwfS * mkWfOrd R _ _ + wfOrd S HwfS :=
              add_lt_add_left _ (limit_lt (wfOrdElt S HwfS) y)
          _ ≤ wfOrd S HwfS * succ (mkWfOrd R _ _) := (mul_succ _ _).ge
          _ ≤ wfOrd S HwfS * mkWfOrd R a (Acc.intro a ‹_›) :=
              mul_le_mul_left _ (succ_least (mk_wf_ord_lt _ _ _ _ h))
          _ ≤ _ := le_add_right _ _
      | right _ h => exact lt_of_le_of_lt (ihb _ h _) (add_lt_add_left _ (mk_wf_ord_lt _ _ _ _ h))

/-- Rocq: `WellFounded.slexprod_is_mul1`. -/
theorem slexprod_is_mul1 (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (Slexprod R S) (wf_slexprod R S HwfR HwfS) ≤ wfOrd S HwfS * wfOrd R HwfR :=
  limit_least fun ⟨a, b⟩ =>
    calc mkWfOrd (Slexprod R S) (a, b) _ ≤ wfOrd S HwfS * wfOrdElt R HwfR a + wfOrdElt S HwfS b :=
          slexprod_elt_le HwfS a _ b _ _
      _ < wfOrd S HwfS * wfOrdElt R HwfR a + wfOrd S HwfS :=
          add_lt_add_left _ (limit_lt (wfOrdElt S HwfS) b)
      _ ≤ wfOrd S HwfS * succ (wfOrdElt R HwfR a) := (mul_succ _ _).ge
      _ ≤ wfOrd S HwfS * wfOrd R HwfR := mul_le_mul_left _ (succ_least (limit_lt (wfOrdElt R HwfR) a))

private theorem slexprod_elt_ge (HwfR : WellFounded R) (HwfS : WellFounded S) (a : A) :
    ∀ b : B, wfOrd S HwfS * wfOrdElt R HwfR a + wfOrdElt S HwfS b ≤
      wfOrdElt (Slexprod R S) (wf_slexprod R S HwfR HwfS) (a, b) := by
  induction a using HwfR.induction with
  | h a iha =>
    -- First, the multiplicative part.
    have hmul : ∀ b : B, wfOrd S HwfS * wfOrdElt R HwfR a ≤
        wfOrdElt (Slexprod R S) (wf_slexprod R S HwfR HwfS) (a, b) := by
      intro b
      show wfOrd S HwfS * mkWfOrd R a _ ≤ _
      rw [mkWfOrd_unfold R, mul_unfold]
      refine sup_least fun ⟨a', ha'⟩ => ?_
      rw [add_unfold]
      refine lub_least ?_ (sup_least fun c => succ_least ?_)
      · exact le_of_lt (lt_of_le_of_lt (le_trans (le_add_right _ _) (iha a' ha' b))
          (wf_ord_lt _ _ _ (.left b b ha')))
      · exact lt_of_le_of_lt (iha a' ha' c) (wf_ord_lt _ _ _ (.left c b ha'))
    intro b
    induction b using HwfS.induction with
    | h b ihb =>
      show wfOrd S HwfS * wfOrdElt R HwfR a + mkWfOrd S b _ ≤ _
      rw [mkWfOrd_unfold S, add_unfold]
      exact lub_least (hmul b) (sup_least fun ⟨b', hb'⟩ => succ_least
        (lt_of_le_of_lt (ihb b' hb') (wf_ord_lt _ _ _ (.right a hb'))))

/-- Rocq: `WellFounded.slexprod_is_mul2`. -/
theorem slexprod_is_mul2 (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd S HwfS * wfOrd R HwfR ≤ wfOrd (Slexprod R S) (wf_slexprod R S HwfR HwfS) := by
  rw [mul_unfold]
  refine sup_least fun a => ?_
  show wfOrd S HwfS * wfOrdElt R HwfR a + wfOrd S HwfS ≤ _
  induction a using HwfR.induction with
  | h a ih =>
    rw [add_unfold]
    refine lub_least ?_ (sup_least fun b => succ_least (lt_of_le_of_lt (slexprod_elt_ge HwfR HwfS a b)
      (limit_lt (wfOrdElt (Slexprod R S) (wf_slexprod R S HwfR HwfS)) (a, b))))
    show wfOrd S HwfS * mkWfOrd R a _ ≤ _
    rw [mkWfOrd_unfold R, mul_unfold]
    exact sup_least fun ⟨a', ha'⟩ => ih a' ha'

/-- The ordinal of a lexicographic product is the product.
Rocq: `WellFounded.slexprod_is_mul`. -/
theorem slexprod_is_mul (HwfR : WellFounded R) (HwfS : WellFounded S) :
    wfOrd (Slexprod R S) (wf_slexprod R S HwfR HwfS) ≈ wfOrd S HwfS * wfOrd R HwfR :=
  equiv_intro (slexprod_is_mul1 HwfR HwfS) (slexprod_is_mul2 HwfR HwfS)

end slexprod

/-- `ℕ × ℕ` in lexicographic order has order type `ω ^ 2`.
Rocq: `WellFounded.slexprod_nat_omega2`. -/
theorem slexprod_nat_omega2 :
    wfOrd (Slexprod (fun a b : Nat => a < b) (fun a b : Nat => a < b))
      (wf_slexprod _ _ nat_lt_wf nat_lt_wf) ≈ (ω : Ordinal.{0}) ^ (2 : Ordinal.{0}) :=
  equiv_trans (slexprod_is_mul nat_lt_wf nat_lt_wf)
    (equiv_trans (mul_congr wf_ord_lt_nat_omega wf_ord_lt_nat_omega)
      (equiv_symm (equiv_trans (pow_succ 1 omega_gt0) (mul_congr (pow_one' omega_gt0) (equiv_refl ω)))))

section dep_lexprod

variable {A : Type u} {B : A → Type u} {R : A → A → Prop} {S : ∀ x, B x → B x → Prop}

private theorem lexprod_elt_le_mul_aux (HwfS : ∀ i, WellFounded (S i)) (i : A) (hi : Acc R i) :
    ∀ (x : B i) (haccx : Acc (S i) x) (hacc : Acc (Lexprod R S) ⟨i, x⟩),
      mkWfOrd (Lexprod R S) ⟨i, x⟩ hacc ≤
        (sup fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) * mkWfOrd R i hi +
          mkWfOrd (S i) x haccx := by
  induction hi with
  | intro i hi ihi =>
    intro x haccx
    induction haccx with
    | intro x _ ihx =>
      intro hacc
      rw [mkWfOrd_unfold (Lexprod R S)]
      refine le_intro fun ⟨p, hp⟩ => ?_
      cases hp with
      | left y _ h =>
        calc mkWfOrd (Lexprod R S) _ _
            ≤ (sup fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) * mkWfOrd R _ (hi _ h) +
                mkWfOrd (S _) y ((HwfS _).apply y) := ihi _ h y _ _
          _ < (sup fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) * mkWfOrd R _ (hi _ h) +
                (sup fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) :=
              add_lt_add_left _ (lt_of_lt_of_le (limit_lt (fun x : B _ => mkWfOrd (S _) x ((HwfS _).apply x)) y)
                (sup_le (fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) _))
          _ ≤ (sup fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) *
                succ (mkWfOrd R _ (hi _ h)) := (mul_succ _ _).ge
          _ ≤ (sup fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) * mkWfOrd R i (Acc.intro i hi) :=
              mul_le_mul_left _ (succ_least (mk_wf_ord_lt _ _ _ _ h))
          _ ≤ _ := le_add_right _ _
      | right _ h => exact lt_of_le_of_lt (ihx _ h _) (add_lt_add_left _ (mk_wf_ord_lt _ _ _ _ h))

/-- Rocq: `WellFounded.lexprod_elt_le_mul`. -/
theorem lexprod_elt_le_mul (_HwfR : WellFounded R) (HwfS : ∀ i, WellFounded (S i)) (q₀ : Σ x, B x)
    (hacc : Acc (Lexprod R S) q₀) (hacci : Acc R q₀.1) (haccx : Acc (S q₀.1) q₀.2) :
    mkWfOrd (Lexprod R S) q₀ hacc ≤
      (sup fun i => lim fun x : B i => mkWfOrd (S i) x ((HwfS i).apply x)) * mkWfOrd R q₀.1 hacci +
        mkWfOrd (S q₀.1) q₀.2 haccx := by
  obtain ⟨i, x⟩ := q₀
  exact lexprod_elt_le_mul_aux HwfS i hacci x haccx hacc

/-- The ordinal of a dependent lexicographic product is at most the product.
Rocq: `WellFounded.lexprod_le_mul`. -/
theorem lexprod_le_mul (HwfR : WellFounded R) (HwfS : ∀ i, WellFounded (S i)) :
    wfOrd (Lexprod R S) (wf_lexprod R S HwfR HwfS) ≤
      (sup fun i : A => wfOrd (S i) (HwfS i)) * wfOrd R HwfR :=
  limit_least fun ⟨i, x⟩ =>
    calc mkWfOrd (Lexprod R S) ⟨i, x⟩ _
        ≤ (sup fun i : A => wfOrd (S i) (HwfS i)) * wfOrdElt R HwfR i + wfOrdElt (S i) (HwfS i) x :=
          lexprod_elt_le_mul HwfR HwfS ⟨i, x⟩ _ _ _
      _ < (sup fun i : A => wfOrd (S i) (HwfS i)) * wfOrdElt R HwfR i + sup fun i : A => wfOrd (S i) (HwfS i) :=
          add_lt_add_left _ (lt_of_lt_of_le (limit_lt (wfOrdElt (S i) (HwfS i)) x)
            (sup_le (fun i : A => wfOrd (S i) (HwfS i)) i))
      _ ≤ (sup fun i : A => wfOrd (S i) (HwfS i)) * succ (wfOrdElt R HwfR i) := (mul_succ _ _).ge
      _ ≤ (sup fun i : A => wfOrd (S i) (HwfS i)) * wfOrd R HwfR :=
          mul_le_mul_left _ (succ_least (limit_lt (wfOrdElt R HwfR) i))

end dep_lexprod

/-! ## Lexicographic exponentiation -/

/-- `ω ^ a * ω` is below `ω ^ b` when `a` is an `R`-predecessor of `b`. -/
private theorem pow_mkWfOrd_pred {A : Type u} {R : A → A → Prop} {a b : A} (ha : Acc R a) (hb : Acc R b)
    (h : R a b) : ω ^ mkWfOrd R a ha * ω ≤ ω ^ mkWfOrd R b hb := by
  rw [mkWfOrd_unfold R b hb]
  exact pow_index_mul_omega_le (mk { a' // R a' b } fun x => mkWfOrd R x.1 (hb.inv x.2)) ⟨a, h⟩

/-- `b + b * n ≈ b * (n + 1)` for finite `n`. -/
private theorem add_mul_ofNat (b : Ordinal.{u}) (n : Nat) : b + b * ofNat n ≈ b * ofNat (n + 1) :=
  equiv_trans (add_congr (equiv_symm (mul_one b)) (equiv_refl _))
    (equiv_trans (equiv_symm (mul_add b 1 _)) (mul_congr (equiv_refl b) (equiv_symm (ofNat_add n 1))))

section lex_exp

variable {A : Type u} {R : A → A → Prop} (HwfR : WellFounded R)

/-- The ordinal of a descending list: `ω ^ x₁ + ω ^ x₂ + ⋯`.
Rocq: `WellFounded.list_interp`. -/
def listInterp : List A → Ordinal.{u}
  | [] => 0
  | x :: xs => ω ^ wfOrdElt R HwfR x + listInterp xs

/-- Rocq: `WellFounded.list_interp_dominated`. -/
theorem list_interp_dominated (a : A) (x : List A) (hacc : Acc R a) (h : Desc R (a :: x)) :
    listInterp HwfR x ≤ ω ^ mkWfOrd R a hacc * ofNat x.length := by
  have hle : ∀ b, b ∈ x → ClosReflTrans R b a := fun b hb => desc_hd (a :: x) h b (.tail _ hb)
  clear h
  induction x with
  | nil => exact zero_least _
  | cons c x ih =>
    calc ω ^ wfOrdElt R HwfR c + listInterp HwfR x
        ≤ ω ^ mkWfOrd R a hacc + ω ^ mkWfOrd R a hacc * ofNat x.length :=
          add_le_add (pow_le_pow_right ω (mk_wf_ord_le_trans _ _ _ _ (hle c (.head _))))
            (ih fun b hb => hle b (.tail _ hb))
      _ ≤ ω ^ mkWfOrd R a hacc * ofNat (x.length + 1) := (add_mul_ofNat _ _).le

/-- The interpretation strictly decreases along the lexicographic order.
Rocq: `WellFounded.lex_exp_lt_interp`. -/
theorem lex_exp_lt_interp (xs ys : List A) (h : Ltl R xs ys) (hd : Desc R xs) :
    listInterp HwfR xs < listInterp HwfR ys := by
  induction h with
  | nil a x => exact lt_of_lt_of_le (pow_pos ω _) (le_add_right _ _)
  | hd hab x y =>
    calc ω ^ wfOrdElt R HwfR _ + listInterp HwfR x
        ≤ ω ^ wfOrdElt R HwfR _ * ofNat (x.length + 1) :=
          le_trans (add_le_add (le_refl _) (list_interp_dominated HwfR _ x _ hd)) (add_mul_ofNat _ _).le
      _ < ω ^ wfOrdElt R HwfR _ * ω := mul_lt_mul_left (pow_pos ω _) (index_lt ω ⟨x.length + 1⟩)
      _ ≤ ω ^ wfOrdElt R HwfR _ := pow_mkWfOrd_pred _ _ hab
      _ ≤ _ := le_add_right _ _
  | tl a _ ih => exact add_lt_add_left _ (ih (dist_Desc_concat [a] _ hd).2)

include HwfR in
/-- Lexicographic exponentiation is well-founded. Rocq:
`Lexicographic_Exponentiation.wf_lex_exp`; here it follows from
`lex_exp_lt_interp`. -/
theorem wf_lex_exp : WellFounded (lexExp R) :=
  wf_incl _ (fun x y => listInterp HwfR x.1 < listInterp HwfR y.1)
    (fun x y h => lex_exp_lt_interp HwfR x.1 y.1 h x.2) (wf_inverse_image (· < ·) _ lt_wf)

/-- Rocq: `WellFounded.list_interp_correct1`. -/
theorem list_interp_correct1 (xs : Pow R) (hacc : Acc (lexExp R) xs) :
    mkWfOrd (lexExp R) xs hacc ≤ listInterp HwfR xs.1 := by
  induction hacc with
  | intro xs _ ih =>
    rw [mkWfOrd_unfold]
    exact le_intro fun ⟨ys, h⟩ => lt_of_le_of_lt (ih ys h) (lex_exp_lt_interp HwfR _ _ h ys.2)

/-- Rocq: `WellFounded.clos_trans_Lt_tail`. -/
theorem clos_trans_Lt_tail (x : A) (a b : List A) (h : ClosTrans (Ltl R) a b) :
    ClosTrans (Ltl R) (x :: a) (x :: b) := by
  induction h with
  | step h => exact .step (.tl x h)
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂

omit HwfR in
/-- Rocq: `WellFounded.Desc_frontways`. -/
theorem Desc_frontways (xs : List A) (x : A) :
    Desc R (x :: xs) ↔ match xs with
      | [] => True
      | x' :: xs' => ClosRefl R x' x ∧ Desc R (x' :: xs') :=
  match xs with
  | [] => ⟨fun _ => trivial, fun _ => .one x⟩
  | _ :: _ =>
    ⟨fun h => let ⟨h₁, h₂⟩ := desc_descF h; ⟨h₁, descF_desc _ h₂⟩,
     fun ⟨h₁, h₂⟩ => descF_desc _ ⟨h₁, desc_descF h₂⟩⟩

omit HwfR in
/-- Rocq: `WellFounded.desc_ltl`. -/
theorem desc_ltl : ∀ (xs : List A) (x : A), Desc R (x :: xs) → Ltl R xs (x :: xs)
  | [], x, _ => .nil x []
  | x' :: xs', x, h =>
    match (Desc_frontways (x' :: xs') x).1 h with
    | ⟨.step h₁, _⟩ => .hd h₁ xs' (x' :: xs')
    | ⟨.refl _, h₂⟩ => .tl x' (desc_ltl xs' x' h₂)

omit HwfR in
private theorem desc_replicate (a : A) : ∀ n : Nat, Desc R (List.replicate n a)
  | 0 => .nil
  | 1 => .one a
  | n + 2 => (Desc_frontways (List.replicate (n + 1) a) a).2 ⟨.refl a, desc_replicate a (n + 1)⟩

private theorem listInterp_replicate (a : A) :
    ∀ n : Nat, listInterp HwfR (List.replicate n a) ≈ ω ^ wfOrdElt R HwfR a * ofNat n
  | 0 => equiv_symm (mul_zero _)
  | n + 1 => equiv_trans (add_congr (equiv_refl _) (listInterp_replicate a n)) (add_mul_ofNat _ n)

/-- Rocq: `WellFounded.list_interp_correct2`. -/
theorem list_interp_correct2 (R_trans : ∀ x y z, R x y → R y z → R x z) (xs : Pow R)
    (hacc : Acc (lexExp R) xs) : listInterp HwfR xs.1 ≤ mkWfOrd (lexExp R) xs hacc := by
  induction xs using (wf_lex_exp HwfR).induction with
  | h xs ih =>
    obtain ⟨l, hl⟩ := xs
    match l, hl, ih with
    | [], _, _ => exact zero_least _
    | x :: xs, hl, ih =>
      have below : ∀ (ys : Pow R) (h : lexExp R ys ⟨x :: xs, hl⟩),
          listInterp HwfR ys.1 < mkWfOrd (lexExp R) ⟨x :: xs, hl⟩ hacc := fun ys h =>
        lt_of_le_of_lt (ih ys h ((wf_lex_exp HwfR).apply ys)) (mk_wf_ord_lt _ _ _ _ h)
      show ω ^ wfOrdElt R HwfR x + listInterp HwfR xs ≤ _
      rw [add_unfold]
      refine lub_least ?_ (sup_least fun i => succ_least ?_)
      · -- the leading power
        show ω ^ mkWfOrd R x _ ≤ _
        rw [pow_unfold, mkWfOrd_unfold R x]
        refine lub_least (succ_least (lt_of_le_of_lt (zero_least _)
          (below ⟨[], .nil⟩ (.nil x xs)))) (sup_least fun ⟨x', hx'⟩ => ?_)
        rw [mul_unfold]
        refine sup_least fun ⟨n⟩ => le_of_lt ?_
        refine lt_of_le_of_lt ?_ (below ⟨List.replicate (n + 1) x', desc_replicate x' (n + 1)⟩
          (.hd hx' _ _))
        exact le_trans (mul_succ _ _).ge (listInterp_replicate HwfR x' (n + 1)).ge
      · -- the tail
        have hxs : Desc R xs := (dist_Desc_concat [x] xs hl).2
        have h₁ : listInterp HwfR xs ≤ mkWfOrd (lexExp R) ⟨xs, hxs⟩ ((wf_lex_exp HwfR).apply _) :=
          ih ⟨xs, hxs⟩ (desc_ltl xs x hl) _
        obtain ⟨⟨q, hq⟩, hqxs, hle⟩ := lt_mkWfOrd (lt_of_lt_of_le (index_lt _ i) h₁)
        have hxq : Desc R (x :: q) := by
          match q, hq, hqxs with
          | [], _, _ => exact .one x
          | c :: q', hq, hqxs =>
            refine (Desc_frontways (c :: q') x).2 ⟨?_, hq⟩
            match xs, hxs, hqxs, (Desc_frontways xs x).1 hl with
            | _ :: _, _, .hd hcd _ _, ⟨.step hdx, _⟩ => exact .step (R_trans _ _ _ hcd hdx)
            | _ :: _, _, .hd hcd _ _, ⟨.refl _, _⟩ => exact .step hcd
            | _ :: _, _, .tl _ _, ⟨h, _⟩ => exact h
        calc ω ^ wfOrdElt R HwfR x + listInterp HwfR xs i
            ≤ ω ^ wfOrdElt R HwfR x + listInterp HwfR q :=
              add_le_add (le_refl _) (le_trans hle (list_interp_correct1 HwfR _ _))
          _ < mkWfOrd (lexExp R) ⟨x :: xs, hl⟩ hacc := below ⟨x :: q, hxq⟩ (.tl x hqxs)

/-- Rocq: `WellFounded.list_interp_correct`. -/
theorem list_interp_correct (R_trans : ∀ x y z, R x y → R y z → R x z) (xs : Pow R)
    (hacc : Acc (lexExp R) xs) : mkWfOrd (lexExp R) xs hacc ≈ listInterp HwfR xs.1 :=
  equiv_intro (list_interp_correct1 HwfR xs hacc) (list_interp_correct2 HwfR R_trans xs hacc)

/-- Lexicographic exponentiation of a transitive well-founded relation has
order type `ω ^ x`. Rocq: `WellFounded.lex_exp_eq`. -/
theorem lex_exp_eq (R_trans : ∀ x y z, R x y → R y z → R x z) :
    wfOrd (lexExp R) (wf_lex_exp HwfR) ≈ ω ^ wfOrd R HwfR := by
  refine equiv_intro (limit_least fun q => ?_) ?_
  · refine lt_of_le_of_lt (list_interp_correct1 HwfR q _) ?_
    obtain ⟨l, hl⟩ := q
    match l, hl with
    | [], _ => exact pow_pos ω _
    | a :: l, hl =>
      calc ω ^ wfOrdElt R HwfR a + listInterp HwfR l
          ≤ ω ^ wfOrdElt R HwfR a * ofNat (l.length + 1) :=
            le_trans (add_le_add (le_refl _) (list_interp_dominated HwfR a l _ hl)) (add_mul_ofNat _ _).le
        _ < ω ^ wfOrdElt R HwfR a * ω := mul_lt_mul_left (pow_pos ω _) (index_lt ω ⟨l.length + 1⟩)
        _ ≤ ω ^ wfOrd R HwfR := pow_index_mul_omega_le (wfOrd R HwfR) a
  · rw [pow_unfold]
    refine lub_least (succ_least (lt_intro (show (wfOrd (lexExp R) (wf_lex_exp HwfR)).Carrier
      from ⟨[], .nil⟩) (zero_least _))) (sup_least fun a => ?_)
    rw [mul_unfold]
    refine sup_least fun ⟨n⟩ => le_of_lt (lt_of_le_of_lt ?_ (limit_lt (wfOrdElt (lexExp R) (wf_lex_exp HwfR))
      ⟨List.replicate (n + 1) a, desc_replicate a (n + 1)⟩))
    exact le_trans (mul_succ _ _).ge (le_trans (listInterp_replicate HwfR a (n + 1)).ge
      (list_interp_correct2 HwfR R_trans ⟨List.replicate (n + 1) a, desc_replicate a (n + 1)⟩ _))

end lex_exp

/-! ## List extension -/

section list_ext

variable {A : Type u} {R : A → A → Prop} (HwfR : WellFounded R)

/-- The natural sum of the tree selections of the elements of a list.
Rocq: `WellFounded.list_ext_interp`. -/
def listExtInterp : List A → Ordinal.{u}
  | [] => 0
  | x :: xs => treeSelection (mkWfOrd R x (HwfR.apply x)) ♯ listExtInterp xs

/-- Rocq: `WellFounded.list_ext_interp_app`. -/
theorem list_ext_interp_app : ∀ xs ys : List A,
    listExtInterp HwfR (xs ++ ys) ≈ listExtInterp HwfR xs ♯ listExtInterp HwfR ys
  | [], _ => equiv_symm (nadd_zero_l _)
  | _ :: xs, ys => equiv_trans (nadd_congr (equiv_refl _) (list_ext_interp_app xs ys)) (nadd_assoc _ _ _)

omit HwfR in
/-- Rocq: `WellFounded.list_ext_nil`. -/
theorem list_ext_nil : ∀ l : List A, ClosReflTrans (ListExt R) [] l
  | [] => .refl _
  | a :: l => .trans (list_ext_nil l) (.step (.intro a [] [] l fun _ h => nomatch h))

/-- The natural sum of the tree selections of `R`-predecessors of `a` is
below the tree selection of `a`. -/
private theorem listExtInterp_lt_tree (a : A) (bs : List A) (hbs : ∀ b, b ∈ bs → R b a) :
    listExtInterp HwfR bs < treeSelection (mkWfOrd R a (HwfR.apply a)) := by
  rw [mkWfOrd_unfold R a, tree_selection_unfold]
  have : ∃ qs : List { a' // R a' a }, listExtInterp HwfR bs ≤
      smashList (lim fun y : { a' // R a' a } => treeSelection (mkWfOrd R y.1 ((HwfR.apply a).inv y.2))) qs := by
    induction bs with
    | nil => exact ⟨[], le_refl _⟩
    | cons b bs ih =>
      obtain ⟨qs, hqs⟩ := ih fun c hc => hbs c (.tail _ hc)
      exact ⟨⟨b, hbs b (.head _)⟩ :: qs, nadd_le_nadd (le_refl _) hqs⟩
  obtain ⟨qs, hqs⟩ := this
  exact lt_of_le_of_lt hqs (limit_lt (fun qs : List { a' // R a' a } =>
    smashList (lim fun y : { a' // R a' a } => treeSelection (mkWfOrd R y.1 ((HwfR.apply a).inv y.2))) qs) qs)

/-- List extension strictly decreases the interpretation. -/
theorem listExtInterp_lt_of_ext {ys xs : List A} (h : ListExt R ys xs) :
    listExtInterp HwfR ys < listExtInterp HwfR xs := by
  cases h with
  | intro a bs l₁ l₂ hbs =>
    calc listExtInterp HwfR (l₁ ++ (bs ++ l₂))
        ≤ listExtInterp HwfR l₁ ♯ (listExtInterp HwfR bs ♯ listExtInterp HwfR l₂) :=
          le_trans (list_ext_interp_app HwfR l₁ _).le
            (nadd_le_nadd (le_refl _) (list_ext_interp_app HwfR bs l₂).le)
      _ < listExtInterp HwfR l₁ ♯ (treeSelection (mkWfOrd R a (HwfR.apply a)) ♯ listExtInterp HwfR l₂) :=
          nadd_increasing2 _ (nadd_increasing1 _ (listExtInterp_lt_tree HwfR a bs hbs))
      _ ≤ listExtInterp HwfR (l₁ ++ a :: l₂) := (list_ext_interp_app HwfR l₁ (a :: l₂)).ge

include HwfR in
/-- List extension of a well-founded relation is well-founded. Rocq:
`List_Extension.wf_list_ext`; here it follows from
`listExtInterp_lt_of_ext`. -/
theorem wf_list_ext : WellFounded (ListExt R) :=
  wf_incl _ (fun x y => listExtInterp HwfR x < listExtInterp HwfR y)
    (fun _ _ h => listExtInterp_lt_of_ext HwfR h) (wf_inverse_image (· < ·) _ lt_wf)

/-- Rocq: `WellFounded.list_ext_interp_le`. -/
theorem list_ext_interp_le (xs : List A) (hxs : Acc (ListExt R) xs) :
    mkWfOrd (ListExt R) xs hxs ≤ listExtInterp HwfR xs := by
  induction hxs with
  | intro xs _ ih =>
    rw [mkWfOrd_unfold]
    exact le_intro fun ⟨ys, h⟩ => lt_of_le_of_lt (ih ys h) (listExtInterp_lt_of_ext HwfR h)

/-- Rocq: `WellFounded.list_ext_interp_lt`. -/
theorem list_ext_interp_lt : ∀ (xs : List A) (q : Ordinal.{u}), q < listExtInterp HwfR xs →
    ∃ l₁ x l₂ q', xs = l₁ ++ x :: l₂ ∧ q' < treeSelection (mkWfOrd R x (HwfR.apply x)) ∧
      q ≤ listExtInterp HwfR l₁ ♯ q' ♯ listExtInterp HwfR l₂
  | [], _, h => (zero_lt _ h).elim
  | a :: xs, _, h =>
    match nadd_lt_cases h with
    | .inl ⟨i, hi⟩ =>
      ⟨[], a, xs, _, rfl, index_lt _ i, le_trans hi (nadd_zero_l _).ge⟩
    | .inr ⟨j, hj⟩ =>
      let ⟨l₁, x, l₂, q', e, hq', hle⟩ := list_ext_interp_lt xs _ (index_lt _ j)
      ⟨a :: l₁, x, l₂, q', e ▸ rfl, hq',
        le_trans hj (le_trans (nadd_le_nadd (le_refl _) hle) (nadd_assoc _ _ _).le)⟩

/-- Rocq: `WellFounded.tree_selection_lt`. -/
theorem tree_selection_lt (q : Ordinal.{u}) (x : A) (hacc : Acc R x)
    (h : q < treeSelection (mkWfOrd R x hacc)) :
    ∃ xs : List A, (∀ b, b ∈ xs → R b x) ∧ q ≤ listExtInterp HwfR xs := by
  rw [mkWfOrd_unfold R x] at h
  obtain ⟨qs, hqs⟩ := lt_elim h
  refine ⟨qs.map (·.1), ?_, le_trans hqs ?_⟩
  · clear hqs
    intro b hb
    induction qs with
    | nil => cases hb
    | cons p qs ih =>
      cases hb with
      | head => exact p.2
      | tail _ hb => exact ih hb
  · clear hqs
    induction qs with
    | nil => exact le_refl _
    | cons p qs ih => exact nadd_le_nadd (le_refl _) ih

/-- Rocq: `WellFounded.list_ext_interp_le2`. -/
theorem list_ext_interp_le2 (xs : List A) (hxs : Acc (ListExt R) xs) :
    listExtInterp HwfR xs ≤ mkWfOrd (ListExt R) xs hxs := by
  induction xs using (wf_list_ext HwfR).induction with
  | h xs ih =>
    refine le_of_forall_lt fun q hq => ?_
    obtain ⟨l₁, x, l₂, q', e, hq', hle⟩ := list_ext_interp_lt HwfR xs q hq
    obtain ⟨qs, hqs₁, hqs₂⟩ := tree_selection_lt HwfR q' x (HwfR.apply x) hq'
    have hext : ListExt R (l₁ ++ (qs ++ l₂)) xs := e ▸ .intro x qs l₁ l₂ hqs₁
    calc q ≤ listExtInterp HwfR l₁ ♯ (listExtInterp HwfR qs ♯ listExtInterp HwfR l₂) :=
          le_trans hle (nadd_le_nadd (le_refl _) (nadd_le_nadd hqs₂ (le_refl _)))
      _ ≤ listExtInterp HwfR (l₁ ++ (qs ++ l₂)) :=
          le_trans (nadd_le_nadd (le_refl _) (list_ext_interp_app HwfR qs l₂).ge)
            (list_ext_interp_app HwfR l₁ _).ge
      _ ≤ mkWfOrd (ListExt R) _ ((wf_list_ext HwfR).apply _) := ih _ hext _
      _ < mkWfOrd (ListExt R) xs hxs := mk_wf_ord_lt _ _ _ _ hext

/-- The ordinal of list extension is the tree selection.
Rocq: `WellFounded.list_ext_is_tree_selection`. -/
theorem list_ext_is_tree_selection :
    wfOrd (ListExt R) (wf_list_ext HwfR) ≈ treeSelection (wfOrd R HwfR) := by
  show wfOrd (ListExt R) (wf_list_ext HwfR) ≈
    iteratedSmashSum (mk A fun a => treeSelection (wfOrdElt R HwfR a))
  have hsl : ∀ xs : List A,
      @smashList (mk A fun a => treeSelection (wfOrdElt R HwfR a)) xs ≈ listExtInterp HwfR xs := by
    intro xs
    induction xs with
    | nil => exact equiv_refl _
    | cons _ _ ih => exact nadd_congr (equiv_refl _) ih
  refine equiv_intro (limit_least fun xs => ?_) (limit_least fun xs => ?_)
  · exact lt_intro (show (iteratedSmashSum (mk A fun a => treeSelection (wfOrdElt R HwfR a))).Carrier
      from xs) (le_trans (list_ext_interp_le HwfR xs _) (hsl xs).ge)
  · exact lt_of_le_of_lt (le_trans (hsl xs).le (list_ext_interp_le2 HwfR xs _))
      (limit_lt (wfOrdElt (ListExt R) (wf_list_ext HwfR)) xs)

omit HwfR in
/-- Rocq: `WellFounded.list_ext_permutation`. -/
theorem list_ext_permutation : Simulation (ListExt R) (ListExt R) (@Permutation A) := by
  intro a a' b h hp
  cases h with
  | intro x bs l₁ l₂ hbs =>
    obtain ⟨l₃, l₄, e⟩ := Permutation_vs_elt_inv b l₁ l₂ x hp.symm
    subst e
    exact ⟨l₃ ++ (bs ++ l₄), .intro x bs l₃ l₄ hbs,
      Permutation_app_middle bs l₁ l₂ l₃ l₄ (Permutation_app_inv l₁ l₂ l₃ l₄ x hp)⟩

include HwfR in
/-- Rocq: `WellFounded.wf_list_ext_perm`. -/
theorem wf_list_ext_perm : WellFounded (relCompose (@Permutation A) (ListExt R)) :=
  wf_self_simulation_prefix Permutation.refl (fun _ _ h => h.symm) (fun _ _ _ h₁ h₂ => .trans h₁ h₂)
    list_ext_permutation (wf_list_ext HwfR)

include HwfR in
/-- Rocq: `WellFounded.wf_list_ext_perm_both`. -/
theorem wf_list_ext_perm_both :
    WellFounded (relCompose (relCompose (@Permutation A) (ListExt R)) (@Permutation A)) :=
  wf_self_simulation_suffix (F := @Permutation A) Permutation.refl (fun _ _ _ h₁ h₂ => .trans h₁ h₂)
    (fun a _ b ⟨c, h₁, h₂⟩ h₃ =>
      let ⟨q, h₄, h₅⟩ := list_ext_permutation a c b h₂ h₃
      ⟨q, ⟨q, Permutation.refl q, h₄⟩, .trans h₁ h₅⟩)
    (wf_list_ext_perm HwfR)

